  <!-- ░░ 05 · ESCALA — stats protagonistas + cinta de reposición ░░ -->
  <section class="scalex" aria-label="Escalabilidad">
    <div class="container">
      <p class="scalex__lead" data-item>Infraestructura diseñada para soportar operaciones complejas:</p>
      <div class="scalex__grid">
        <div class="stat" data-item>
          <span class="stat__v"><em data-statnum="25">0</em>+</span>
          <span class="stat__l">desde redes de 25 colaboradores</span>
        </div>
        <div class="stat" data-item>
          <span class="stat__v">Multi</span>
          <span class="stat__l">hasta ecosistemas multi-marca y multi-bodega</span>
        </div>
        <div class="stat" data-item>
          <span class="stat__v"><em data-statnum="100">0</em>%</span>
          <span class="stat__l">de los movimientos con trazabilidad auditable</span>
        </div>
      </div>
    </div>
    <div class="conveyor conveyor--alt" data-conveyor="1" aria-hidden="true">
      <div class="conveyor__track" data-conveyor-track>
        {[...conveyor, ...conveyor].map((c) => (
          <span class="crate">
            <i class={`crate__dot crate__dot--${c.estado}`}></i>
            <span class="crate__name">{c.name}</span>
            <span class="crate__sku">#{c.sku}</span>
            <span class="crate__qty">{c.qty}</span>
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- ░░ ROADMAP IA ░░ -->
  <section class="roadmap" id="roadmap" aria-label="Roadmap">
    <div class="container roadmap__grid">
      <header class="shead shead--tight" data-item>
        <span class="kicker">Visión tecnológica</span>
        <h2>Preparando sus datos para la planificación predictiva.</h2>
        <p>La eficiencia parte por consolidar datos históricos fiables. Al implementar SmartOrder hoy,
        su holding construye la base estructurada para nuestro próximo despliegue.</p>
      </header>
      <div class="forecast" data-item>
        <span class="badge"><i aria-hidden="true"></i>En desarrollo</span>
        <h3>Agente Planner <span>IA</span></h3>
        <p>Procesará su historial de consumo, estacionalidad y tiempos logísticos para sugerir
        pronósticos de demanda de alta precisión.</p>
        <div class="forecast__chart">
          <svg viewBox="0 0 320 96" preserveAspectRatio="none" aria-hidden="true">
            <polyline data-chart-base points="0,76 45,64 90,68 135,46 180,52 225,32 270,36 320,16"
              fill="none" stroke="currentColor" stroke-width="2" />
            <polyline class="forecast__dash" data-chart-pred points="225,32 270,24 320,8"
              fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="5 6" />
          </svg>
          <span class="forecast__label">Forecast</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ░░ FINALE — fondo shader iridiscente (§17) ░░ -->
  <section class="finale" id="agendar" aria-label="Agendar">
    <ShaderField />
    <div class="container finale__inner" data-finale>
      <h2><span class="line" data-fline>Escale su operación</span><span class="line" data-fline>con <em>datos confiables</em>.</span></h2>
      <p>Bodegas y compras corporativas en una plataforma que prioriza la seguridad de la
      información y la eficiencia administrativa.</p>
      <a class="btn btn--primary btn--lg" href={order} data-magnetic>Agendar Reunión Técnica</a>
      <span class="finale__meta">Implementación guiada · Integración API con su POS</span>
    </div>
  </section>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  ScrollTrigger.config({ ignoreMobileResize: true });

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let mm;
  let introDone = false; // la intro del hero solo corre en la primera carga, no en cada navegación

  function magnetic() {
    if (!window.matchMedia('(pointer: fine)').matches) return;
    document.querySelectorAll('[data-magnetic]').forEach((el) => {
      const qx = gsap.quickTo(el, 'x', { duration: 0.5, ease: 'power3.out' });
      const qy = gsap.quickTo(el, 'y', { duration: 0.5, ease: 'power3.out' });
      el.addEventListener('mousemove', (e) => {
        const r = el.getBoundingClientRect();
        qx((e.clientX - (r.left + r.width / 2)) * 0.3);
        qy((e.clientY - (r.top + r.height / 2)) * 0.3);
      });
      el.addEventListener('mouseleave', () => gsap.to(el, { x: 0, y: 0, duration: 0.6, ease: 'elastic.out(1, 0.3)' }));
    });
  }

  function intro() {
    const counter = document.querySelector('[data-count]');
    // Solo animar la entrada en la PRIMERA carga. En navegaciones (View Transitions)
    // el hero ya se renderiza visible → evita el "salto"/doble carga al cambiar de página.
    if (reduced || introDone) {
      introDone = true;
      if (counter) counter.textContent = '52 SKUs';
      return;
    }
    introDone = true;

    const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
    tl.from('[data-title]', { y: 42, opacity: 0, duration: 1.15 }, 0.1)
      .from('.chip[data-reveal]', { y: 14, opacity: 0, duration: 0.7 }, 0.15)
      .from('.hero__lead[data-reveal]', { y: 18, opacity: 0, duration: 0.8 }, '-=0.7')
      .from('.hero__insights[data-reveal]', { y: 18, opacity: 0, duration: 0.8 }, '-=0.65')
      .from('.hero__cta[data-reveal]', { y: 18, opacity: 0, duration: 0.8 }, '-=0.6')
      .from('[data-visual]', { y: 50, opacity: 0, duration: 1.2 }, 0.3)
      .from('[data-panel]', { y: 60, opacity: 0, duration: 1.1 }, '-=0.8')
      .from('[data-row]', { x: 26, opacity: 0, stagger: 0.08, duration: 0.55 }, '-=0.6')
      .from('[data-conveyor]', { opacity: 0, duration: 0.8 }, '-=0.5');

    if (counter) {
      const o = { v: 0 };
      gsap.to(o, { v: 52, duration: 1.6, delay: 0.7, ease: 'power1.out',
        onUpdate: () => { counter.textContent = `${Math.round(o.v)} SKUs`; } });
    }
  }

  function scenes() {
    // ── Cintas de productos: viajan con el scroll (todos los tamaños — slides que avanzan) ──
    if (!reduced) {
      document.querySelectorAll('[data-conveyor]').forEach((c) => {
        const dir = Number(c.dataset.conveyor) || -1;
        const track = c.querySelector('[data-conveyor-track]');
        if (!track) return;
        gsap.fromTo(track,
          { xPercent: dir === -1 ? 0 : -28 },
          { xPercent: dir === -1 ? -28 : 0, ease: 'none',
            scrollTrigger: { trigger: c, start: 'top bottom', end: 'bottom top', scrub: 0.4 } });
      });
    }

    // ── Reveals editoriales (todos los tamaños) ──
    gsap.utils.toArray('.shead').forEach((h) => {
      gsap.from(h.children, { y: 30, opacity: 0, stagger: 0.1, duration: 0.9, ease: 'expo.out',
        scrollTrigger: { trigger: h, start: 'top 84%' } });
    });
    gsap.utils.toArray('[data-item]').forEach((el) => {
      gsap.from(el, { y: 36, opacity: 0, duration: 0.9, ease: 'expo.out',
        scrollTrigger: { trigger: el, start: 'top 86%' } });
    });

    // Líneas del ledger se dibujan
    if (!reduced) {
      gsap.utils.toArray('.ledger__row').forEach((row) => {
        gsap.from(row, { '--rule': '0%', duration: 1.1, ease: 'expo.out',
          scrollTrigger: { trigger: row, start: 'top 85%' } });
      });
    }

    // ── Stats con count-up al entrar al viewport ──
    document.querySelectorAll('[data-statnum]').forEach((el) => {
      const target = Number(el.dataset.statnum) || 0;
      if (reduced) { el.textContent = String(target); return; }
      const o = { v: 0 };
      gsap.to(o, {
        v: target, duration: 1.6, ease: 'power1.out',
        scrollTrigger: { trigger: el, start: 'top 85%' },
        onUpdate: () => { el.textContent = String(Math.round(o.v)); },
      });
    });

    // ── Chart del forecast: histórico se dibuja, luego la predicción punteada ──
    const base = document.querySelector('[data-chart-base]');
    const pred = document.querySelector('[data-chart-pred]');
    if (base && !reduced) {
      const lb = base.getTotalLength();
      gsap.set(base, { strokeDasharray: lb, strokeDashoffset: lb });
      const tl = gsap.timeline({ scrollTrigger: { trigger: '.forecast', start: 'top 72%' } });
      tl.to(base, { strokeDashoffset: 0, duration: 1.4, ease: 'power2.out' });
      if (pred) {
        gsap.set(pred, { opacity: 0 });
        tl.to(pred, { opacity: 1, duration: 0.6 }, '-=0.3');
      }
    }

    // Finale: reveal por líneas
    gsap.from('[data-fline]', { yPercent: 115, stagger: 0.1, duration: 1, ease: 'expo.out',
      scrollTrigger: { trigger: '[data-finale]', start: 'top 75%' } });
    gsap.from('[data-finale] > p, [data-finale] > .btn, [data-finale] > .finale__meta', {
      y: 24, opacity: 0, stagger: 0.1, duration: 0.8, ease: 'expo.out',
      scrollTrigger: { trigger: '[data-finale]', start: 'top 70%' } });

    if (mm) mm.revert();
    mm = gsap.matchMedia();

    // ════ DESKTOP: profundidad del visual, transición de sheets ════
    mm.add('(min-width: 768px)', () => {
      if (reduced) return;

      // Visual e inventario con leve profundidad al scrollear (parallax sutil)
      gsap.to('[data-visual]', { yPercent: -5, ease: 'none',
        scrollTrigger: { trigger: '[data-hero]', start: 'top top', end: 'bottom top', scrub: true } });
      gsap.to('[data-panel]', { yPercent: -16, ease: 'none',
        scrollTrigger: { trigger: '[data-hero]', start: 'top top', end: 'bottom top', scrub: true } });

      // La plataforma: el scroll AVANZA el módulo en el dispositivo (sala de control)
      const os = document.querySelector('[data-os]');
      if (os) {
        const screens = gsap.utils.toArray('#plataforma [data-os-screen]');
        const dots = gsap.utils.toArray('#plataforma [data-os-dot]');
        const prog = document.querySelector('#plataforma [data-os-progress]');
        const n = screens.length;
        gsap.set(screens, { autoAlpha: 0, yPercent: 6 });
        gsap.set(screens[0], { autoAlpha: 1, yPercent: 0 });
        // Timeline de n unidades: cada módulo OCUPA 1 unidad (se mantiene) y
        // transiciona en el borde → ritmo uniforme, sin huecos largos en negro.
        const tl = gsap.timeline({ defaults: { ease: 'power2.inOut' },
          scrollTrigger: {
            trigger: os, start: 'top top', end: 'bottom bottom', scrub: 0.4,
            onUpdate: (self) => {
              const idx = Math.min(n - 1, Math.floor(self.progress * n * 0.999));
              dots.forEach((d, i) => d.classList.toggle('is-active', i === idx));
              if (prog) prog.style.transform = 'scaleY(' + self.progress.toFixed(3) + ')';
            },
          } });
        for (let i = 1; i < n; i++) {
          // la transición arranca en la unidad i (tras el hold del módulo anterior)
          tl.to(screens[i - 1], { autoAlpha: 0, yPercent: -6, duration: 0.45 }, i)
            .fromTo(screens[i], { autoAlpha: 0, yPercent: 6 }, { autoAlpha: 1, yPercent: 0, duration: 0.45 }, i);
        }
        tl.to({}, { duration: 0.01 }, n); // hold final → el último módulo no se va a negro
      }

      // Planning (diagrama vivo): productos entran a la bodega, se ORDENAN en el estante,
      // y los cables conectan con los nodos de la historia.
      const plan = document.querySelector('[data-plan]');
      const box = document.querySelector('[data-plan-box]');
      if (plan && box) {
        const chips = gsap.utils.toArray('[data-pchip]');
        const tiles = gsap.utils.toArray('[data-shelf] [data-ptile]');
        const wires = gsap.utils.toArray('[data-wires] [data-wire]');
        const pkts  = gsap.utils.toArray('[data-wires] [data-pkt]');
        const nodes = gsap.utils.toArray('[data-pnode]');

        // Estados iniciales
        gsap.set(tiles, { autoAlpha: 0, scale: 0.6, transformOrigin: '50% 50%' });
        gsap.set(nodes, { autoAlpha: 0, y: 18 });
        gsap.set(pkts, { autoAlpha: 0 });
        gsap.set(wires, { autoAlpha: 0 });
        // Paquetes viajando por cada cable (loop continuo; entrada hacia la bodega, salida desde ella)
        wires.forEach((w, idx) => {
          const L = w.getTotalLength();
          const a = w.getPointAtLength(0);      // extremo en la bodega
          const b = w.getPointAtLength(L);      // extremo en el nodo
          const pkt = pkts[idx]; if (!pkt) return;
          const inbound = pkt.getAttribute('data-pkt') === 'in';
          const from = inbound ? b : a, to = inbound ? a : b;
          gsap.set(pkt, { attr: { cx: from.x, cy: from.y } });
          gsap.fromTo(pkt, { attr: { cx: from.x, cy: from.y } },
            { attr: { cx: to.x, cy: to.y }, duration: 1.9, ease: 'none', repeat: -1, delay: idx * 0.35 });
        });

        const br = box.getBoundingClientRect();
        const bcx = br.left + br.width / 2, bcy = br.top + br.height / 2;
        const ptl = gsap.timeline({
          scrollTrigger: { trigger: plan, start: 'top top', end: 'bottom bottom', scrub: 0.5 } });

        // 1) chips vuelan a la bodega y se absorben
        chips.forEach((c, idx) => {
          const r = c.getBoundingClientRect();
          ptl.to(c, {
            x: bcx - (r.left + r.width / 2), y: bcy - (r.top + r.height / 2),
            scale: 0.4, autoAlpha: 0, ease: 'power2.in', duration: 0.55,
          }, idx * 0.05);
        });
        // 2) el inventario se ORDENA en el estante (cada tile aparece a medida que llega su producto)
        tiles.forEach((t, idx) => {
          ptl.to(t, { autoAlpha: 1, scale: 1, ease: 'back.out(1.7)', duration: 0.4 }, 0.15 + idx * 0.05);
        });
        // 3) la bodega late al quedar ordenada
        ptl.to(box, { scale: 1.03, duration: 0.35, ease: 'power2.out' }, 0.7)
           .to(box, { scale: 1, duration: 0.3 }, '>');
        // 4) los cables aparecen conectando la bodega con cada nodo
        wires.forEach((w, idx) => {
          ptl.to(w, { autoAlpha: 1, ease: 'power1.inOut', duration: 0.5 }, 0.95 + idx * 0.12);
        });
        ptl.to(pkts, { autoAlpha: 1, duration: 0.4 }, 1.15);
        // 5) los nodos de la historia se revelan en secuencia
        nodes.forEach((nd, idx) => {
          ptl.to(nd, { autoAlpha: 1, y: 0, ease: 'expo.out', duration: 0.5 }, 1.1 + idx * 0.28);
        });
        ptl.to({}, { duration: 0.4 }); // hold final
      }
    });

    // ════ MOBILE: mismo diagrama pinneado + galería horizontal de nodos ════
    mm.add('(max-width: 767px) and (prefers-reduced-motion: no-preference)', () => {
      const plan  = document.querySelector('[data-plan]');
      const box   = document.querySelector('[data-plan-box]');
      const track = document.querySelector('[data-pnode-track]');
      if (!plan || !box || !track) return;

      const chips = gsap.utils.toArray('[data-pchip]');
      const tiles = gsap.utils.toArray('[data-shelf] [data-ptile]');

      // Estado inicial: estante vacío y galería oculta (se revelan con el scroll)
      gsap.set(tiles, { autoAlpha: 0, scale: 0.6, transformOrigin: '50% 50%' });
      gsap.set(track, { autoAlpha: 0 });

      const tl = gsap.timeline({
        scrollTrigger: { trigger: plan, start: 'top top', end: 'bottom bottom', scrub: 0.5 },
      });

      // 1) los chips vuelan a la bodega y se absorben
      const br = box.getBoundingClientRect();
      const bcx = br.left + br.width / 2, bcy = br.top + br.height / 2;
      chips.forEach((c, i) => {
        const r = c.getBoundingClientRect();
        tl.to(c, {
          x: bcx - (r.left + r.width / 2), y: bcy - (r.top + r.height / 2),
          scale: 0.4, autoAlpha: 0, ease: 'power2.in', duration: 0.5,
        }, i * 0.04);
      });
      // 2) el inventario se ORDENA en el estante (igual que en desktop)
      tiles.forEach((t, i) =>
        tl.to(t, { autoAlpha: 1, scale: 1, ease: 'back.out(1.7)', duration: 0.4 }, 0.2 + i * 0.05));
      // 3) la bodega late al quedar ordenada
      tl.to(box, { scale: 1.03, duration: 0.3, ease: 'power2.out' }, 0.75)
        .to(box, { scale: 1, duration: 0.25 }, '>');
      // 4) aparece la galería de nodos (la caja con productos queda arriba)
      tl.to(track, { autoAlpha: 1, duration: 0.4 }, 1.05);
      // 5) scroll lateral por las cards hasta la última, luego se despinnea y sigue normal
      const overflow = Math.max(0, track.scrollWidth - window.innerWidth);
      if (overflow > 0) tl.to(track, { x: -overflow, ease: 'none', duration: 2.2 }, 1.25);
      tl.to({}, { duration: 0.3 }); // hold final
    });
  }

  // El fondo de la página muta de color entre secciones (oscuro → gris → blanco → oscuro).
  // Sin pins: funciona con cualquier altura de contenido, en todos los tamaños.
  function bgMorph() {
    if (reduced) return;
    const css = getComputedStyle(document.documentElement);
    const v = (name) => css.getPropertyValue(name).trim();

    const stops = [
      { trigger: '#desafios',     to: v('--surface-light'), deco: 0 },
      { trigger: '#planning',     to: v('--bg-primary'),    deco: 0 },
      { trigger: '#plataforma',   to: v('--bg-primary'),    deco: 0 },
      { trigger: '#arquitectura', to: v('--bg-primary'),    deco: 0 },
    ];

    let prev = v('--bg-primary');
    let prevDeco = 0.35;
    stops.forEach((s) => {
      const st = { trigger: s.trigger, start: 'top 78%', end: 'top 28%', scrub: true };
      gsap.fromTo('[data-bgmorph]', { backgroundColor: prev },
        { backgroundColor: s.to, ease: 'none', immediateRender: false, scrollTrigger: st });
      gsap.fromTo('.deco', { opacity: prevDeco },
        { opacity: s.deco, ease: 'none', immediateRender: false, scrollTrigger: { ...st } });
      prev = s.to;
      prevDeco = s.deco;
    });
  }

  function initMotion() {
    scenes();
    bgMorph();
    magnetic();
    intro();
    ScrollTrigger.refresh();
  }
  document.addEventListener('astro:page-load', initMotion);
  window.addEventListener('load', () => ScrollTrigger.refresh());
</script>

<style>
  /* ════ Atmósfera ════ */
  /* Atmósfera mínima: solo una retícula tenue en la parte alta. Sin auroras. */
  .deco {
    position: fixed; inset: 0; z-index: -1; pointer-events: none;
    background-image:
      linear-gradient(color-mix(in srgb, var(--border) 40%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--border) 40%, transparent) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(70% 55% at 50% 0%, #000 0%, transparent 72%);
    opacity: 0.35;
  }

  .kicker {
    display: inline-block; font-size: var(--text-xs); font-weight: 600;
    letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent);
  }

  /* ════ Botones ════ */
  .btn {
    display: inline-flex; align-items: center; gap: 0.55em;
    font-family: var(--font-body); font-weight: 500; font-size: var(--text-sm);
    padding: 0.75em 1.4em; border-radius: var(--radius-full); text-decoration: none;
    border: 1px solid transparent;
    transition: background-color var(--transition-fast), border-color var(--transition-fast),
                color var(--transition-fast), box-shadow var(--transition-fast);
    will-change: transform;
  }
  .btn--primary {
    background: var(--accent); color: var(--bg-primary); border-color: var(--accent);
    box-shadow: 0 6px 22px color-mix(in srgb, var(--accent) 18%, transparent);
  }
  .btn--primary:hover { background: var(--accent-hover); box-shadow: 0 8px 30px color-mix(in srgb, var(--accent) 30%, transparent); }
  .btn--ghost { background: transparent; color: var(--text-primary); border-color: color-mix(in srgb, var(--border) 95%, transparent); }
  .btn--ghost:hover { border-color: var(--accent); color: var(--accent); }
  .btn--ghost span { transition: transform var(--transition-fast); }
  .btn--ghost:hover span { transform: translateX(4px); }
  .btn--lg { font-size: var(--text-base); padding: 0.85em 1.8em; }

  .chip {
    display: inline-flex; align-items: center; gap: 0.6em;
    font-size: var(--text-xs); font-weight: 500; letter-spacing: 0.04em;
    color: var(--text-secondary);
    padding: 0.5em 1em; border-radius: var(--radius-full);
    border: 1px solid color-mix(in srgb, var(--border) 95%, transparent);
    background: color-mix(in srgb, var(--bg-secondary) 60%, transparent);
    backdrop-filter: blur(8px);
  }
  .chip i {
    width: 7px; height: 7px; border-radius: var(--radius-full);
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    animation: chip-pulse 2.4s ease-in-out infinite;
  }
  @keyframes chip-pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.35; } }

  /* ════ HERO (dividido en 2) ════ */
  .hero { position: relative; padding-top: clamp(6.5rem, 16vh, 9.5rem); overflow: hidden; }
  .hero__grid {
    display: grid; grid-template-columns: 1fr;
    gap: var(--space-lg);
    align-items: center;
  }
  .hero__copy { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-md); }
  .hero__title {
    font-family: var(--font-heading); font-weight: 600;
    font-size: clamp(2.1rem, 3.6vw, 3.4rem);
    line-height: 1.08; letter-spacing: -0.03em;
    color: var(--text-primary);
    max-width: 19ch;
  }
  .hero__title em {
    font-style: normal;
    background: linear-gradient(100deg, var(--accent), var(--accent-hover));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hero__lead {
    font-size: var(--text-base);
    color: var(--text-secondary); line-height: 1.7; max-width: 50ch;
  }
  .hero__insights { list-style: none; display: grid; gap: 0.7em; }
  .hero__insights li {
    display: flex; gap: 0.7em; align-items: flex-start;
    font-size: var(--text-sm); color: var(--text-secondary); line-height: 1.55;
    max-width: 52ch;
  }
  .hero__insights strong { color: var(--text-primary); font-weight: 600; }
  .insight__check {
    flex-shrink: 0; width: 1.35em; height: 1.35em; margin-top: 0.1em;
