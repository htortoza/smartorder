            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ░░ 04 · ARQUITECTURA — diagrama vivo POS → SmartOrder → Bodegas ░░ -->
  <section class="arch" id="arquitectura" aria-label="Arquitectura">
    <div class="container">
      <header class="shead">
        <span class="kicker">05 — Arquitectura</span>
        <h2>Conectado a su punto de venta.</h2>
        <p>Cada transacción del POS deduce materias primas en tiempo real y queda registrada
        en un log de auditoría inmutable.</p>
      </header>

      <div class="flow" data-item aria-hidden="true">
        <div class="flow__node">
          <span class="flow__ico">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
          </span>
          <span class="flow__name">POS / Venta</span>
          <span class="flow__tag">transacción</span>
        </div>
        <div class="flow__lane"><i></i></div>
        <div class="flow__node flow__node--core">
          <img src={withBase('/isotipo.svg')} alt="" width="34" height="38" />
          <span class="flow__name">SmartOrder</span>
          <span class="flow__tag">BOM · reglas · audit log</span>
        </div>
        <div class="flow__lane flow__lane--d2"><i></i></div>
        <div class="flow__node">
          <span class="flow__ico">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 8l9-5 9 5v8l-9 5-9-5z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg>
          </span>
          <span class="flow__name">Bodegas</span>
          <span class="flow__tag">stock en tiempo real</span>
        </div>
