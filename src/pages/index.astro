                    <ul class="oclist" role="list">
                      <li class="ocrow"><span class="ocrow__id">TR-0883</span><span class="ocrow__prov">Central → Vitacura</span><span class="ocrow__amt">84 u</span><span class="badge badge--warn">En tránsito</span></li>
                      <li class="ocrow"><span class="ocrow__id">TR-0881</span><span class="ocrow__prov">Central → Las Condes</span><span class="ocrow__amt">120 u</span><span class="badge badge--ok">Recibida</span></li>
                      <li class="ocrow"><span class="ocrow__id">TR-0879</span><span class="ocrow__prov">Providencia → Central</span><span class="ocrow__amt">36 u</span><span class="badge badge--neutral">Por recibir</span></li>
                      <li class="ocrow"><span class="ocrow__id">TR-0874</span><span class="ocrow__prov">Central → Ñuñoa</span><span class="ocrow__amt">52 u</span><span class="badge badge--ok">Recibida</span></li>
                    </ul>
