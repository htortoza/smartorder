---
// src/pages/index.astro — HOME BESPOKE v2 (SmartOrder)
// Concepto: "la bodega en movimiento" — el inventario fluye entre secciones.
// Header dock flotante · hero limpio con HUD · panel 3D que se endereza ·
// cintas de productos ligadas al scroll · sheets que se apilan · pipeline API ·
// módulos en galería horizontal · chart predictivo dibujado por scroll.
// NO regenerar con generate.js.
import Layout from '../layouts/Layout.astro';
import ShaderField from '../components/ShaderField.astro';
import site from '../../contracts/site.json';
import { withBase } from '../lib/path.js';

const order = site.orderUrl;

const seo = {
  title: 'SmartOrder — Abastecimiento e inventario para holdings',
  description: 'Plataforma multi-empresa para centralizar compras, inventario y trazabilidad. Integración API, gobernanza financiera y auditoría incorruptible.',
  googleFontsUrl: 'https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap',
  schemaData: {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'SmartOrder',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    description: 'Plataforma multi-empresa de abastecimiento e inventario para operaciones gastronómicas.',
  },
};

const rows = [
  { name: 'Banana',             sku: 'SKU-7802820032016', stock: '142', estado: 'ok' },
  { name: 'Agua mineral 500ml', sku: 'SKU-7802820007014', stock: '38',  estado: 'bajo' },
  { name: 'Maní salado',        sku: 'SKU-7802820018010', stock: '6',   estado: 'critico' },
  { name: 'Aceite vegetal 1L',  sku: 'SKU-7802820044019', stock: '74',  estado: 'ok' },
];

// Productos que viajan por las cintas (la bodega en movimiento)
const conveyor = [
  { name: 'Banana',             sku: '0320', qty: '142 un', estado: 'ok' },
  { name: 'Agua mineral 500ml', sku: '0070', qty: '38 un',  estado: 'bajo' },
  { name: 'Harina 25kg',        sku: '0911', qty: '12 sac', estado: 'ok' },
  { name: 'Café grano 1kg',     sku: '0455', qty: '26 un',  estado: 'ok' },
  { name: 'Maní salado',        sku: '0180', qty: '6 un',   estado: 'critico' },
  { name: 'Queso gouda kg',     sku: '0762', qty: '18 kg',  estado: 'ok' },
  { name: 'Tomate triturado',   sku: '0533', qty: '44 un',  estado: 'ok' },
  { name: 'Aceite vegetal 1L',  sku: '0440', qty: '74 un',  estado: 'ok' },
];

const desafios = [
  { n: '01', t: 'Descentralización de Compras', d: 'Falta de políticas automatizadas que prevengan sobrecostos, compras fuera de contrato o adquisiciones no autorizadas por gerencia.' },
  { n: '02', t: 'Silos de Información (Stock)', d: 'Desconexión entre la venta real y la deducción teórica de insumos, generando mermas no justificadas y quiebres de stock en sucursales.' },
  { n: '03', t: 'Auditorías Vulnerables', d: 'Procesos de conteo físico susceptibles a errores o manipulaciones, dificultando la consolidación contable a fin de mes.' },
];

const pipeline = [
  { t: 'Integración Transaccional (API)', d: 'Deducción exacta y automática de materias primas (BOM) con cada transacción registrada en su POS.', tag: 'POS → Stock' },
  { t: 'Trazabilidad Incorruptible', d: 'Log de auditoría completo para cada ajuste de stock, transferencia entre bodegas y recepción de mercancía.', tag: 'Audit log' },
  { t: 'Gobernanza Multi-Tenant', d: 'Múltiples razones sociales, marcas y bodegas desde un único panel con permisos granulares por usuario.', tag: 'Multi-empresa' },
];

---

<Layout
  title={seo.title}
  description={seo.description}
  googleFontsUrl={seo.googleFontsUrl}
  schemaData={seo.schemaData}
>
  <div class="bgmorph" data-bgmorph aria-hidden="true"></div>
  <div class="deco" aria-hidden="true"></div>

  <!-- ░░ HERO — dividido en 2: copy izquierda / visual derecha ░░ -->
  <section class="hero" id="top" data-hero aria-label="Inicio">
    <div class="container hero__grid">
      <div class="hero__copy">
        <span class="chip" data-reveal>
          <i aria-hidden="true"></i>
          Plataforma Multi-Empresa · Operaciones Gastronómicas
        </span>
        <h1 class="hero__title" data-title>
          Centralice el <em>abastecimiento</em> y control de inventario de su holding.
        </h1>
        <p class="hero__lead" data-reveal>
          Estandarice sus flujos de compra y automatice la deducción de recetas mediante
          integración API. Visibilidad y trazabilidad total para su cadena logística.
        </p>
        <ul class="hero__insights" data-reveal>
          <li>
            <span class="insight__check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg></span>
            <span><strong>Trazabilidad 100% auditable.</strong> Registro inmutable por usuario, fecha y sucursal.</span>
          </li>
          <li>
            <span class="insight__check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg></span>
            <span><strong>Gobernanza financiera.</strong> Aprobación jerárquica para la emisión de Órdenes de Compra.</span>
          </li>
        </ul>
        <div class="hero__cta" data-reveal>
          <a class="btn btn--primary" href={order} data-magnetic>Solicitar Demostración</a>
          <a class="btn btn--ghost" href="#solucion">Ver Arquitectura del Sistema<span aria-hidden="true">→</span></a>
        </div>
      </div>

      <!-- Visual: imagen de bodega (Magnific) + panel de inventario superpuesto -->
      <div class="hero__visual" data-stage>
        <figure class="visual" data-visual>
          <img src={withBase('/images/hero-visual.jpg')} alt="Bodega de distribución gastronómica moderna con gestor revisando inventario en tablet" />
          <figcaption class="visual__cap">
            <span class="visual__dot" aria-hidden="true"></span>
            Bodega central · Sincronizada
          </figcaption>
        </figure>

        <div class="panel" data-panel aria-hidden="true">
          <span class="panel__scan" aria-hidden="true"></span>
          <div class="panel__bar">
            <span class="panel__brand"><img src={withBase('/isotipo.svg')} alt="" width="14" height="16" />Inventario · Holding</span>
            <span class="panel__pill panel__pill--accent" data-count>52</span>
          </div>
          <div class="panel__head"><span>Producto</span><span>SKU</span><span>Stock</span><span>Estado</span></div>
          <ul class="panel__rows">
            {rows.map((r) => (
              <li class="prow" data-row>
                <span class="prow__name">{r.name}</span>
                <span class="prow__sku">{r.sku}</span>
                <span class="prow__stock">{r.stock}</span>
                <span class={`tag tag--${r.estado}`}>{r.estado === 'ok' ? 'Óptimo' : r.estado === 'bajo' ? 'Bajo' : 'Crítico'}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- Cinta 1: productos saliendo de bodega (se desliza con el scroll) -->
    <div class="conveyor" data-conveyor="-1" aria-hidden="true">
      <div class="conveyor__track" data-conveyor-track>
        {[...conveyor, ...conveyor].map((c) => (
          <span class="crate">
            <i class={`crate__dot crate__dot--${c.estado}`}></i>
            <span class="crate__name">{c.name}</span>
            <span class="crate__sku">#{c.sku}</span>
            <span class="crate__qty">{c.qty}</span>
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- ░░ 02 · DESAFÍOS — narrativa sticky + ledger con cifras fantasma (Magnific) ░░ -->
  <section class="sheet sheet--a" id="desafios" aria-label="Desafíos">
    <div class="container sheet__inner desa">
      <div class="desa__aside">
        <header class="shead">
          <span class="kicker">02 — El problema a escala</span>
          <h2>Superando los cuellos de botella en la operación a escala.</h2>
          <p>La dependencia de procesos manuales y hojas de cálculo fragmentadas introduce
          riesgos operativos y financieros que impactan el margen de contribución.</p>
        </header>
        <figure class="desa__img" data-item>
          <img src={withBase('/images/desafios-chaos.webp')} alt="Facturas y planillas en papel dispersas sobre una superficie oscura: la operación manual a escala" loading="lazy" />
          <figcaption>La operación manual: papel, planillas y errores</figcaption>
        </figure>
      </div>
      <ol class="ledger" role="list">
        {desafios.map((c) => (
          <li class="ledger__row" data-item>
            <span class="ledger__ghost" aria-hidden="true">{c.n}</span>
            <div class="ledger__body">
              <h3>{c.t}</h3>
              <p>{c.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ░░ 03 · EL SISTEMA — productos flotando entran a la bodega y se vuelven datos/recetas ░░ -->
  <section class="plan-sec" id="planning" aria-label="Planning de inventario">
    <span class="plan-sec__grain" aria-hidden="true"></span>
    <div class="container plan__head">
      <span class="kicker">03 — El sistema en marcha</span>
      <h2 class="plan__title">Planning para gestión<br>de inventario</h2>
      <p class="plan__lead">Recibe tu inventario, ordénalo en bodegas y conviértelo en información viva:
      órdenes de compra, recetas estandarizadas y descuento automático al vender.</p>
    </div>

    <div class="plan" data-plan>
      <div class="plan__stage">
        <div class="container plan__inner">

          <!-- Cables que conectan la bodega con cada salida (diagrama vivo) -->
          <svg class="plan__wires" data-wires viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <path class="wire" data-wire d="M34 27 L15 22" />
            <path class="wire" data-wire d="M34 53 L15 60" />
            <path class="wire" data-wire d="M66 27 L85 18" />
            <path class="wire" data-wire d="M68 40 L86 45" />
            <path class="wire" data-wire d="M66 53 L84 73" />
            <circle class="wire__pkt" data-pkt="in"  r="0.7" />
            <circle class="wire__pkt" data-pkt="in"  r="0.7" />
            <circle class="wire__pkt" data-pkt="out" r="0.7" />
            <circle class="wire__pkt" data-pkt="out" r="0.7" />
            <circle class="wire__pkt" data-pkt="out" r="0.7" />
          </svg>

          <!-- Nube de productos que flotan y entran a la bodega -->
          <div class="plan__cloud" aria-hidden="true">
            <span class="pchip" data-pchip style="top:6%;left:8%">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 12c4-5 10-5 14 0-4 5-10 5-14 0Z"/><circle cx="14" cy="12" r="1.1" fill="currentColor" stroke="none"/><path d="M17 12h4l-2 3 2 3-6-2"/></svg>
              Salmón
            </span>
            <span class="pchip" data-pchip style="top:2%;left:60%">
              <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="7" cy="8" r="1.3"/><circle cx="12" cy="6" r="1.3"/><circle cx="17" cy="8" r="1.3"/><circle cx="9" cy="13" r="1.3"/><circle cx="15" cy="13" r="1.3"/><circle cx="12" cy="18" r="1.3"/></svg>
              Arroz
            </span>
            <span class="pchip" data-pchip style="top:22%;left:80%">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3c5 0 8 4 8 9s-3 9-8 9-8-4-8-9c0-3 1-5 3-6"/><circle cx="12" cy="14" r="2.4"/></svg>
              Palta
            </span>
            <span class="pchip" data-pchip style="top:64%;left:6%">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3c3 4 5 6 5 9a5 5 0 0 1-10 0c0-3 2-5 5-9Z"/></svg>
              Aceite
            </span>
            <span class="pchip" data-pchip style="top:82%;left:28%">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><ellipse cx="12" cy="12" rx="5" ry="8"/><path d="M12 5c-1.5 3-1.5 11 0 14"/></svg>
              Café
            </span>
            <span class="pchip" data-pchip style="top:84%;left:64%">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="5" width="14" height="14" rx="2"/><path d="M9 9l6 6M15 9l-6 6"/></svg>
              Nori
            </span>
            <span class="pchip" data-pchip style="top:42%;left:-2%">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 8l8-4 8 4-8 4-8-4Z"/><path d="M4 8v8l8 4 8-4V8"/></svg>
              Harina
            </span>
            <span class="pchip" data-pchip style="top:14%;left:34%">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="7" width="14" height="11" rx="1.5"/><path d="M9 7V5h6v2"/></svg>
              Azúcar
            </span>
          </div>

          <!-- Caja central: la bodega con su inventario ya ordenado -->
          <div class="plan__box" data-plan-box aria-hidden="true">
            <span class="plan__box-glow"></span>
            <div class="plan__box-head">
              <svg class="plan__box-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 7l9-4 9 4-9 4-9-4Z"/><path d="M3 7v10l9 4 9-4V7"/><path d="M12 11v10"/></svg>
              <span class="plan__box-label">Bodega · SmartOrder</span>
              <span class="plan__box-tag">Inventario ordenado</span>
            </div>
            <div class="plan__shelf" data-shelf>
              <span class="ptile" data-ptile><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 12c4-5 10-5 14 0-4 5-10 5-14 0Z"/><circle cx="14" cy="12" r="1.1" fill="currentColor" stroke="none"/><path d="M17 12h4l-2 3 2 3-6-2"/></svg><b>Salmón</b><i>24</i></span>
              <span class="ptile" data-ptile><svg viewBox="0 0 24 24" fill="currentColor"><circle cx="7" cy="8" r="1.3"/><circle cx="12" cy="6" r="1.3"/><circle cx="17" cy="8" r="1.3"/><circle cx="9" cy="13" r="1.3"/><circle cx="15" cy="13" r="1.3"/><circle cx="12" cy="18" r="1.3"/></svg><b>Arroz</b><i>60</i></span>
              <span class="ptile" data-ptile><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3c5 0 8 4 8 9s-3 9-8 9-8-4-8-9c0-3 1-5 3-6"/><circle cx="12" cy="14" r="2.4"/></svg><b>Palta</b><i>38</i></span>
              <span class="ptile" data-ptile><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3c3 4 5 6 5 9a5 5 0 0 1-10 0c0-3 2-5 5-9Z"/></svg><b>Aceite</b><i>15</i></span>
              <span class="ptile" data-ptile><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><ellipse cx="12" cy="12" rx="5" ry="8"/><path d="M12 5c-1.5 3-1.5 11 0 14"/></svg><b>Café</b><i>26</i></span>
              <span class="ptile" data-ptile><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="5" width="14" height="14" rx="2"/><path d="M9 9l6 6M15 9l-6 6"/></svg><b>Nori</b><i>90</i></span>
              <span class="ptile" data-ptile><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 8l8-4 8 4-8 4-8-4Z"/><path d="M4 8v8l8 4 8-4V8"/></svg><b>Harina</b><i>9</i></span>
              <span class="ptile" data-ptile><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="7" width="14" height="11" rx="1.5"/><path d="M9 7V5h6v2"/></svg><b>Azúcar</b><i>18</i></span>
            </div>
          </div>

          <!-- Nodos de la historia (desktop: absolutos con cables · mobile: galería horizontal) -->
          <div class="pnode-track" data-pnode-track>
          <div class="pnode pnode--in" data-pnode style="left:15%;top:22%">
            <span class="pnode__n">01</span>
            <div class="pnode__b"><h3>Recepción</h3><p>42 SKU recibidos y verificados contra la orden.</p></div>
          </div>
          <div class="pnode pnode--in" data-pnode style="left:15%;top:60%">
            <span class="pnode__n">02</span>
            <div class="pnode__b"><h3>Orden en bodegas</h3><p>Cada insumo asignado a su ubicación y sucursal.</p></div>
          </div>
          <div class="pnode pnode--out" data-pnode style="left:85%;top:18%">
            <span class="pnode__n">03</span>
            <div class="pnode__b"><h3>Orden de inventario</h3><p>Stock y niveles consolidados en tiempo real.</p></div>
          </div>
          <div class="pnode pnode--out" data-pnode style="left:86%;top:45%">
            <span class="pnode__n">04</span>
            <div class="pnode__b"><h3>Recetas (BOM)</h3><p>Costo teórico por plato, estandarizado.</p></div>
          </div>
          <div class="pnode pnode--out" data-pnode style="left:84%;top:73%">
            <span class="pnode__n">05</span>
            <div class="pnode__b"><h3>Descuento al vender</h3><p>El POS deduce la materia prima en cada venta.</p></div>
          </div>
          </div><!-- /.pnode-track -->

        </div>
      </div>
    </div>
  </section>

  <!-- ░░ 04 · LA PLATAFORMA — sala de control: el scroll recorre cada módulo ░░ -->
  <section class="os-sec" id="plataforma" aria-label="La plataforma">
    <span class="os-sec__grain" aria-hidden="true"></span>
    <div class="container">
      <header class="shead">
        <span class="kicker">04 — La plataforma</span>
        <h2>Estandarización, control y visibilidad en tiempo real.</h2>
        <p>Arquitectura multi-empresa nativa que conecta el consumo en el punto de venta con la
        planificación de bodegas. Cada movimiento, respaldado por reglas de negocio estrictas.</p>
      </header>
    </div>

    <div class="os" data-os>
      <div class="os__stage">
        <div class="container os__inner">
          <aside class="os__rail">
            <span class="os__track" aria-hidden="true"><span class="os__progress" data-os-progress></span></span>
            <ol role="list">
              <li class="os__dot is-active" data-os-dot="0">
                <span class="os__rn">1.0</span>
                <div class="os__rtext">
                  <span class="os__rlabel">Gestión de Compras</span>
                  <p class="os__rdesc">Cotizaciones y Órdenes de Compra vinculadas a flujos de aprobación gerencial según límites de presupuesto.</p>
                </div>
              </li>
              <li class="os__dot" data-os-dot="1">
                <span class="os__rn">2.0</span>
                <div class="os__rtext">
                  <span class="os__rlabel">Control de Bodegas</span>
                  <p class="os__rdesc">Transferencias internas con validación de “Stock en Tránsito”: salida y recepción confirmadas, sin mermas no justificadas.</p>
                </div>
              </li>
              <li class="os__dot" data-os-dot="2">
                <span class="os__rn">3.0</span>
                <div class="os__rtext">
                  <span class="os__rlabel">Auditoría y Conteos</span>
                  <p class="os__rdesc">Conteos físicos “a ciegas”. El sistema cruza conteo vs. stock teórico y alerta cada discrepancia.</p>
                </div>
              </li>
              <li class="os__dot" data-os-dot="3">
                <span class="os__rn">4.0</span>
                <div class="os__rtext">
                  <span class="os__rlabel">Ingeniería de Menú</span>
                  <p class="os__rdesc">Recetas estandarizadas y centralizadas para asegurar el costo teórico de cada producción.</p>
                </div>
              </li>
            </ol>
          </aside>

          <div class="os__device">
            <div class="os__chrome" aria-hidden="true">
              <span class="os__traffic"><i></i><i></i><i></i></span>
              <span class="os__app">SmartOrder OS</span>
              <span class="os__live"><i></i> en vivo</span>
            </div>
            <div class="os__screens">

              <div class="os__screen" data-os-screen="0">
                <h3 class="os__sn"><b>1.0</b> Gestión de Compras</h3>
                <p class="os__desc">Cotizaciones y Órdenes de Compra vinculadas a flujos de aprobación gerencial según límites de presupuesto.</p>
                <div class="mock" aria-hidden="true">
                  <div class="mock__bar"><span>Órdenes de Compra</span><span class="mock__id">Junio · 14 activas</span></div>
                  <div class="mock__body">
                    <div class="mock__row mock__row--dim"><span>Presupuesto mensual</span><span>68% · $12,4M de $18,2M</span></div>
                    <div class="mock__meter"><i style="width:68%"></i></div>
                    <ul class="oclist" role="list">
                      <li class="ocrow"><span class="ocrow__id">OC-2041</span><span class="ocrow__prov">Proveedor Pacífico Ltda.</span><span class="ocrow__amt">$1.842.500</span><span class="badge badge--warn">Gerencia</span></li>
                      <li class="ocrow"><span class="ocrow__id">OC-2038</span><span class="ocrow__prov">Distribuidora Andina</span><span class="ocrow__amt">$642.300</span><span class="badge badge--ok">Aprobada</span></li>
                      <li class="ocrow"><span class="ocrow__id">OC-2035</span><span class="ocrow__prov">Frutas del Sur</span><span class="ocrow__amt">$318.900</span><span class="badge badge--neutral">En revisión</span></li>
                      <li class="ocrow"><span class="ocrow__id">OC-2030</span><span class="ocrow__prov">Lácteos Cordillera</span><span class="ocrow__amt">$97.450</span><span class="badge badge--bad">Rechazada</span></li>
                    </ul>
                    <div class="mock__sub">Flujo de aprobación · OC-2041</div>
                    <ol class="approve" role="list">
                      <li class="approve__step is-done"><i></i>Solicitada · J. Rivas</li>
                      <li class="approve__step is-done"><i></i>Jefa de Compras · M. Soto</li>
                      <li class="approve__step is-active"><i></i>Gerencia · pendiente</li>
                    </ol>
                  </div>
                </div>
              </div>

              <div class="os__screen" data-os-screen="1">
                <h3 class="os__sn"><b>2.0</b> Control de Bodegas</h3>
                <p class="os__desc">Transferencias internas con validación de “Stock en Tránsito”: salida y recepción confirmadas.</p>
                <div class="mock" aria-hidden="true">
                  <div class="mock__bar"><span>Transferencias</span><span class="mock__id">3 en curso</span></div>
                  <div class="mock__body">
                    <div class="transit">
                      <div class="transit__node">
                        <span class="transit__name">Bodega Central</span>
                        <span class="transit__tag is-ok">Salida confirmada</span>
