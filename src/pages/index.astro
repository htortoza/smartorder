  }
  .insight__check svg { width: 0.75em; height: 0.75em; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: var(--space-xs); }

  /* ── Visual derecha: imagen Magnific a sangre + panel superpuesto ── */
  .hero__visual { position: relative; }
  .visual {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
    height: 100%;
  }
  .visual img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .visual__cap {
    position: absolute; top: var(--space-sm); left: var(--space-sm);
    display: inline-flex; align-items: center; gap: 0.55em;
    font-family: var(--font-mono); font-size: var(--text-xs);
    color: var(--text-primary);
    padding: 0.45em 0.9em; border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--bg-primary) 64%, transparent);
    backdrop-filter: blur(10px);
    border: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
  }
  .visual__dot {
    width: 6px; height: 6px; border-radius: var(--radius-full);
    background: var(--accent);
    animation: chip-pulse 2.4s ease-in-out infinite;
  }

  .panel {
    position: absolute;
    left: clamp(-4rem, -8%, -1rem); bottom: clamp(-3rem, -6%, -1rem);
    width: min(92%, 460px);
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--bg-secondary) 96%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 14%, var(--border));
    box-shadow: 0 34px 90px rgba(0, 0, 0, 0.55);
    transform-origin: center bottom;
    will-change: transform;
  }
  /* Línea de escaneo sutil */
  .panel__scan {
    position: absolute; left: 0; right: 0; height: 72px; z-index: 1; pointer-events: none;
    background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--accent) 7%, transparent), transparent);
    animation: scan 5.5s var(--ease-expo) infinite;
  }
  @keyframes scan { 0% { top: -80px; } 60%, 100% { top: 110%; } }

  .panel__bar {
    display: flex; align-items: center; gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--border);
  }
  .panel__brand {
    display: inline-flex; align-items: center; gap: 0.6em;
    font-size: var(--text-sm); font-weight: 600; color: var(--text-primary);
  }
  .panel__brand img { display: block; }
  .panel__pill {
    font-family: var(--font-mono); font-size: var(--text-xs); color: var(--text-secondary);
    padding: 0.35em 0.8em; border: 1px solid var(--border); border-radius: var(--radius-full);
    white-space: nowrap; flex-shrink: 0;
  }
  .panel__pill--accent { margin-left: auto; color: var(--accent); border-color: color-mix(in srgb, var(--accent) 40%, transparent); }

  .panel__head, .prow {
    display: grid; grid-template-columns: 1.5fr 1.7fr 0.6fr 0.9fr; gap: var(--space-sm);
    align-items: center; padding: 0.8em var(--space-md);
  }
  .panel__head {
    font-size: var(--text-xs); letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--text-secondary); border-bottom: 1px solid var(--border);
  }
  .panel__rows { list-style: none; }
  .prow { border-bottom: 1px solid color-mix(in srgb, var(--border) 50%, transparent); transition: background-color var(--transition-fast); }
  .prow:hover { background: color-mix(in srgb, var(--accent) 4%, transparent); }
  .prow:last-child { border-bottom: none; }
  .prow__name { color: var(--text-primary); font-weight: 500; font-size: var(--text-sm); }
  .prow__sku { color: var(--text-secondary); font-family: var(--font-mono); font-size: var(--text-xs); }
  .prow__stock { color: var(--text-primary); font-family: var(--font-mono); font-size: var(--text-sm); font-variant-numeric: tabular-nums; }
  .tag { font-size: var(--text-xs); font-weight: 600; padding: 0.32em 0.75em; border-radius: var(--radius-full); text-align: center; }
  .tag--ok      { color: var(--accent);  background: color-mix(in srgb, var(--accent) 15%, transparent); }
  .tag--bajo    { color: var(--warning); background: color-mix(in srgb, var(--warning) 15%, transparent); }
  .tag--critico { color: var(--danger);  background: color-mix(in srgb, var(--danger) 15%, transparent); }

  /* ════ Cintas transportadoras ════ */
  .conveyor {
    margin-top: clamp(var(--space-lg), 8vh, var(--space-xl));
    padding-block: var(--space-sm);
    border-block: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
    background:
      repeating-linear-gradient(90deg,
        color-mix(in srgb, var(--border) 35%, transparent) 0 2px, transparent 2px 26px);
    overflow: hidden;
  }
  .conveyor--alt { margin-top: 0; }
  .conveyor__track { display: flex; gap: var(--space-sm); width: max-content; will-change: transform; padding-block: 0.4rem; }
  .crate {
    display: inline-flex; align-items: center; gap: 0.7em;
    padding: 0.6em 1em;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--bg-secondary) 92%, transparent);
    border: 1px solid var(--border);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
    white-space: nowrap;
  }
  .crate__dot { width: 7px; height: 7px; border-radius: var(--radius-full); }
  .crate__dot--ok      { background: var(--accent); }
  .crate__dot--bajo    { background: var(--warning); }
  .crate__dot--critico { background: var(--danger); }
  .crate__name { font-size: var(--text-sm); font-weight: 500; color: var(--text-primary); }
  .crate__sku  { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--text-secondary); }
  .crate__qty  { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--accent); }

  /* ════ Underlay de color: el fondo de la página muta entre secciones ════ */
  .bgmorph {
    position: fixed; inset: 0; z-index: -2;
    background-color: var(--bg-primary);
    will-change: background-color;
  }

  /* ════ SECCIONES CLARAS (transparentes: el color lo pone el morph) ════ */
  .stack { position: relative; }
  .sheet { position: relative; }
  .sheet__inner { width: 100%; padding-block: clamp(var(--space-xl), 16vh, var(--space-2xl)); }

  /* Tipografía sobre superficies claras */
  .sheet .kicker { color: var(--accent-ink); }
  .sheet .shead h2 { color: var(--text-on-light); }
  .sheet .shead p { color: var(--text-on-light-soft); }

  .shead { max-width: 60ch; display: flex; flex-direction: column; gap: var(--space-sm); margin-bottom: var(--space-lg); }
  .shead h2 {
    font-family: var(--font-heading); font-weight: 600;
    font-size: clamp(1.7rem, 3.4vw, 2.7rem); line-height: 1.08; letter-spacing: -0.03em;
    color: var(--text-primary);
  }
  .shead p { color: var(--text-secondary); font-size: var(--text-base); line-height: 1.7; max-width: 54ch; }
  .shead--tight { margin-bottom: 0; }

  /* ── Ledger de desafíos: cifra fantasma gigante + regla que se dibuja ── */
  .ledger { list-style: none; min-width: 0; }
  .ledger__row {
    --rule: 100%;
    position: relative;
    display: grid; grid-template-columns: 1fr; gap: var(--space-sm);
    min-width: 0;
    padding-block: var(--space-lg);
    transition: transform var(--transition-fast);
  }
  .ledger__row:hover { transform: translateX(8px); }
  .ledger__row::before {
    content: '';
    position: absolute; top: 0; left: 0;
    width: var(--rule); height: 1px;
    background: linear-gradient(to right, color-mix(in srgb, var(--accent-ink) 60%, transparent), var(--border-on-light));
  }
  /* Número como elemento gráfico (§15.5): cifra fantasma de outline */
  .ledger__ghost {
    font-family: var(--font-heading); font-weight: 600;
    font-size: clamp(3rem, 11vw, 5.5rem);
    line-height: 0.92; letter-spacing: -0.04em;
    color: color-mix(in srgb, var(--accent-ink) 9%, transparent);
    -webkit-text-stroke: 1px color-mix(in srgb, var(--accent-ink) 34%, transparent);
    transition: color var(--transition-fast);
  }
  .ledger__row:hover .ledger__ghost { color: color-mix(in srgb, var(--accent-ink) 22%, transparent); }
  .ledger__body { display: grid; gap: var(--space-xs); min-width: 0; }
  .ledger__row h3 {
    font-family: var(--font-heading); font-weight: 600;
    font-size: clamp(var(--text-lg), 2.2vw, var(--text-xl));
    letter-spacing: -0.02em; color: var(--text-on-light);
  }
  .ledger__row p { color: var(--text-on-light-soft); font-size: var(--text-sm); line-height: 1.7; max-width: 52ch; }

  /* ════ 02 · DESAFÍOS: narrativa sticky + ledger ════ */
  .desa { display: grid; grid-template-columns: 1fr; gap: var(--space-lg); align-items: start; }
  .desa__aside { position: relative; display: grid; gap: var(--space-md); min-width: 0; }
  /* Glow esmeralda decorativo detrás de la narrativa (textura/profundidad) */
  .desa__aside::before {
    content: '';
    position: absolute; z-index: -1;
    left: -10%; top: -8%; width: 70%; aspect-ratio: 1;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 16%, transparent), transparent 68%);
    filter: blur(40px); pointer-events: none;
  }
  .desa__img {
    position: relative; min-width: 0;
    border-radius: var(--radius-lg); overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--border-on-light));
    box-shadow: 0 24px 60px rgba(10, 20, 23, 0.22),
                0 0 32px color-mix(in srgb, var(--accent) 14%, transparent);
  }
  .desa__img img {
    display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover;
    transform: scale(1.02);
    transition: transform 0.9s var(--ease-expo);
  }
  .desa__img:hover img { transform: scale(1.06); }
  /* Scrim inferior: integra la imagen al fondo y da legibilidad a la caption */
  .desa__img::after {
    content: '';
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(to top,
      color-mix(in srgb, var(--bg-primary) 78%, transparent) 0%,
      transparent 42%);
  }
  .desa__img figcaption {
    position: absolute; left: var(--space-sm); bottom: var(--space-sm); z-index: 1;
    font-family: var(--font-mono); font-size: var(--text-xs);
    color: var(--text-primary);
    padding: 0.45em 0.9em; border-radius: var(--radius-full);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    background: color-mix(in srgb, var(--bg-primary) 62%, transparent);
    backdrop-filter: blur(10px);
  }

  /* ════ 03b · RECORRIDO PINNEADO — SALA DE CONTROL OSCURA ════ */
  .os-sec {
    position: relative;
    /* ⚠ NO usar overflow:hidden aquí — rompe el position:sticky del stage */
    background:
      radial-gradient(120% 75% at 50% -8%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 58%),
      var(--bg-primary);
    color: var(--text-primary);
    padding-block: clamp(var(--space-xl), 14vh, var(--space-2xl));
  }
  /* Scanlines de monitor (textura sutil) */
  .os-sec__grain {
    position: absolute; inset: 0; z-index: 0; pointer-events: none; opacity: 0.4;
    background-image: repeating-linear-gradient(to bottom,
      color-mix(in srgb, #fff 4%, transparent) 0 1px, transparent 1px 3px);
    mix-blend-mode: overlay;
  }
  .os-sec .container { position: relative; z-index: 1; }
  .os-sec .shead h2 { color: var(--text-primary); }
  .os-sec .shead p { color: var(--text-secondary); }
  .os-sec .kicker { color: var(--accent); }

  /* Base (móvil y reduced-motion): pantallas apiladas, estáticas */
  .os { position: relative; z-index: 1; }
  .os__inner { display: grid; gap: var(--space-lg); margin-top: var(--space-lg); }
  .os__rail { display: none; }
  .os__device {
    position: relative;
    border-radius: var(--radius-lg); overflow: hidden;
    background: color-mix(in srgb, var(--bg-secondary) 88%, #000);
    border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--border));
    box-shadow: 0 30px 80px rgba(0,0,0,0.5), 0 0 60px color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .os__chrome {
    display: flex; align-items: center; gap: 0.8em;
    padding: 0.7em var(--space-md);
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 16%, var(--border));
    background: color-mix(in srgb, #000 28%, transparent);
  }
  .os__traffic { display: inline-flex; gap: 0.4em; }
  .os__traffic i { width: 9px; height: 9px; border-radius: 50%; background: color-mix(in srgb, var(--text-secondary) 45%, transparent); }
  .os__traffic i:first-child { background: var(--accent); box-shadow: 0 0 8px var(--accent); }
  .os__app { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--text-secondary); letter-spacing: 0.04em; }
  .os__live {
    margin-left: auto; display: inline-flex; align-items: center; gap: 0.45em;
    font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent);
  }
  .os__live i { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 8px var(--accent); animation: chip-pulse 1.8s ease-in-out infinite; }
  .os__screens { display: grid; gap: var(--space-lg); padding: var(--space-md); }
  .os__screen { display: grid; gap: var(--space-sm); }
  .os__sn { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-lg); color: var(--text-primary); }
  .os__sn b { font-family: var(--font-mono); font-weight: 400; color: var(--accent); margin-right: 0.4em; }
  .os__desc { color: var(--text-secondary); font-size: var(--text-sm); line-height: 1.6; max-width: 52ch; }
  /* Panel del módulo: superficie que "brilla" sobre el negro */
  .os__screen .mock {
    border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--border));
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--bg-secondary) 72%, #000);
    box-shadow: inset 0 0 40px color-mix(in srgb, var(--accent) 6%, transparent);
  }

  /* — Mockups de producto (UI oscura sobre fondo claro) — */
  .mock {
    border-radius: var(--radius-lg); overflow: hidden;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    box-shadow: 0 24px 60px rgba(10, 20, 23, 0.18);
    will-change: transform;
    transition: transform 0.6s var(--ease-expo), box-shadow 0.6s var(--ease-expo), border-color 0.6s var(--ease-expo);
  }
  .mock__bar {
    display: flex; justify-content: space-between; align-items: center;
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--border);
    font-size: var(--text-sm); font-weight: 600; color: var(--text-primary);
  }
  .mock__id { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--accent); font-weight: 400; }
  .mock__body { padding: var(--space-sm) var(--space-md) var(--space-md); display: grid; gap: 0.7em; }
  .mock__row {
    display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-sm);
    font-size: var(--text-sm); color: var(--text-primary);
  }
  .mock__row strong { font-weight: 600; font-variant-numeric: tabular-nums; }
  .mock__row--dim { color: var(--text-secondary); font-size: var(--text-xs); }
  .mock__meter { height: 4px; border-radius: var(--radius-full); background: color-mix(in srgb, var(--border) 80%, transparent); overflow: hidden; }
  .mock__meter i { display: block; height: 100%; background: var(--accent); border-radius: inherit; }
  .mock__intransit { color: var(--warning); }
  .mock__total {
    display: flex; justify-content: space-between; align-items: baseline;
    border-top: 1px solid var(--border); padding-top: 0.7em;
    font-size: var(--text-sm); color: var(--text-primary);
  }
  .mock__total strong { color: var(--accent); font-size: var(--text-lg); font-variant-numeric: tabular-nums; }
  .mock__alert {
    font-size: var(--text-xs); color: var(--danger);
    border: 1px solid color-mix(in srgb, var(--danger) 35%, transparent);
    background: color-mix(in srgb, var(--danger) 8%, transparent);
    border-radius: var(--radius-sm); padding: 0.6em 0.9em;
  }
  /* Subtítulo dentro del mockup */
  .mock__sub {
    font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--text-secondary);
    padding-top: 0.5em; border-top: 1px solid var(--border); margin-top: 0.1em;
  }
  /* Lista de registros (OC, transferencias, platos) */
  .oclist { list-style: none; display: grid; gap: 0; }
  .ocrow {
    display: grid; grid-template-columns: auto 1fr auto auto; gap: var(--space-sm);
    align-items: center; padding-block: 0.6em;
    border-top: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
    font-size: var(--text-sm); color: var(--text-primary);
  }
  .ocrow:first-child { border-top: none; }
  .ocrow__id { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--accent); }
  .ocrow__prov { color: var(--text-primary); min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ocrow__amt { font-variant-numeric: tabular-nums; color: var(--text-secondary); }
  .badge {
    justify-self: end; white-space: nowrap;
    font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.04em;
    padding: 0.28em 0.7em; border-radius: var(--radius-full);
    border: 1px solid var(--border); color: var(--text-secondary);
  }
  .badge--ok { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, transparent); background: color-mix(in srgb, var(--accent) 8%, transparent); }
  .badge--warn { color: var(--warning); border-color: color-mix(in srgb, var(--warning) 45%, transparent); background: color-mix(in srgb, var(--warning) 8%, transparent); }
  .badge--bad { color: var(--danger); border-color: color-mix(in srgb, var(--danger) 45%, transparent); background: color-mix(in srgb, var(--danger) 8%, transparent); }
  .badge--neutral { color: var(--text-secondary); }

  /* ════ 03 · EL SISTEMA — planning de inventario (productos → bodega → datos) ════ */
  .plan-sec {
    position: relative;
    background:
      radial-gradient(100% 60% at 50% 0%, color-mix(in srgb, var(--accent) 13%, transparent), transparent 60%),
      var(--bg-primary);
    color: var(--text-primary);
    padding-top: clamp(var(--space-xl), 14vh, var(--space-2xl));
    padding-bottom: clamp(var(--space-xl), 10vh, var(--space-2xl));
  }
  .plan-sec__grain {
    position: absolute; inset: 0; z-index: 0; pointer-events: none; opacity: 0.4;
    background-image: repeating-linear-gradient(to bottom, color-mix(in srgb, #fff 4%, transparent) 0 1px, transparent 1px 3px);
    mix-blend-mode: overlay;
  }
  .plan__head { position: relative; z-index: 1; text-align: center; max-width: 60ch; }
  .plan__head .kicker { color: var(--accent); }
  .plan__title {
    font-family: var(--font-heading); font-weight: 600;
    font-size: clamp(2.3rem, 7vw, 5.2rem); line-height: 1.02; letter-spacing: -0.04em;
    margin-top: 0.3em; text-wrap: balance;
  }
  .plan__lead { margin: var(--space-md) auto 0; max-width: 56ch; color: var(--text-secondary); font-size: var(--text-base); line-height: 1.6; }

  /* Base (móvil / reduced): nube en grid, caja con estante, nodos apilados — estático */
  .plan { position: relative; z-index: 1; }
  .plan__inner { display: grid; gap: var(--space-lg); margin-top: var(--space-xl); justify-items: center; }
  .plan__wires { display: none; }
  .plan__cloud {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-sm);
    width: 100%; max-width: 520px;
  }
  .pchip {
    display: inline-flex; align-items: center; gap: 0.7em;
    padding: 0.75em 1.15em; border-radius: var(--radius-full);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--border));
    background: color-mix(in srgb, var(--bg-secondary) 80%, #000);
    font-size: var(--text-base); color: var(--text-primary); white-space: nowrap;
  }
  .pchip svg { width: 22px; height: 22px; color: var(--accent); flex-shrink: 0; }

  /* Caja-bodega con inventario ordenado */
  .plan__box {
    position: relative; width: 100%; max-width: 520px;
    border-radius: var(--radius-lg);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--border));
    background: color-mix(in srgb, var(--bg-secondary) 88%, #000);
    box-shadow: 0 0 60px color-mix(in srgb, var(--accent) 16%, transparent);
    overflow: hidden;
  }
  .plan__box-head {
    display: flex; align-items: center; gap: 0.7em;
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 20%, var(--border));
    background: color-mix(in srgb, #000 26%, transparent);
  }
  .plan__box-ico { width: 26px; height: 26px; color: var(--accent); flex-shrink: 0; }
  .plan__box-label { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-sm); color: var(--text-primary); }
  .plan__box-tag { margin-left: auto; font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
  .plan__box-glow { position: absolute; inset: 0; border-radius: inherit; pointer-events: none; box-shadow: inset 0 0 40px color-mix(in srgb, var(--accent) 12%, transparent); }
  .plan__shelf {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px;
    background: color-mix(in srgb, var(--accent) 14%, var(--border));
    padding: 1px;
  }
  .ptile {
    display: flex; align-items: center; gap: 0.6em;
    padding: 0.7em 0.9em; background: color-mix(in srgb, var(--bg-secondary) 88%, #000);
    font-size: var(--text-sm); color: var(--text-primary);
  }
  .ptile svg { width: 18px; height: 18px; color: var(--accent); flex-shrink: 0; }
  .ptile b { font-weight: 500; }
  .ptile i { margin-left: auto; font-family: var(--font-mono); font-style: normal; font-size: var(--text-xs); color: var(--text-secondary); }

  /* Nodos de la historia (conectados a la bodega) */
  .pnode {
    display: grid; grid-template-columns: auto 1fr; gap: 0.3em var(--space-sm); align-items: baseline;
    width: 100%; max-width: 520px;
    padding: var(--space-sm) var(--space-md); border-radius: var(--radius-md);
    border: 1px solid var(--border); background: color-mix(in srgb, var(--bg-secondary) 60%, transparent);
  }
  .pnode__n {
    grid-row: span 2; font-family: var(--font-mono); font-size: var(--text-base); color: var(--accent);
  }
  .pnode--out .pnode__n { color: var(--accent); }
  .pnode__b h3 { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-base); color: var(--text-primary); }
  .pnode__b p { color: var(--text-secondary); font-size: var(--text-sm); line-height: 1.5; }
  /* Wrapper de nodos: transparente por defecto (desktop absolutos / base apilados); en mobile-animado pasa a fila horizontal */
  .pnode-track { display: contents; }

  /* flujo de aprobación (1.0) */
  .approve { list-style: none; display: grid; gap: 0.45em; margin-top: 0.3em; }
  .approve__step {
    display: flex; align-items: center; gap: 0.6em;
    font-size: var(--text-xs); color: var(--text-secondary);
  }
  .approve__step i {
    width: 14px; height: 14px; border-radius: var(--radius-full);
    border: 1px solid var(--border); flex-shrink: 0;
  }
  .approve__step.is-done { color: var(--text-primary); }
  .approve__step.is-done i { background: var(--accent); border-color: var(--accent); }
  .approve__step.is-active { color: var(--warning); }
  .approve__step.is-active i { border-color: var(--warning); animation: chip-pulse 1.8s ease-in-out infinite; }

  /* transferencia en tránsito (2.0) */
  .transit { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--space-sm); }
  .transit__node { display: grid; gap: 0.35em; }
  .transit__name { font-size: var(--text-sm); font-weight: 600; color: var(--text-primary); }
  .transit__tag {
    justify-self: start;
    font-family: var(--font-mono); font-size: 0.65rem; color: var(--text-secondary);
    padding: 0.25em 0.7em; border: 1px solid var(--border); border-radius: var(--radius-full);
  }
  .transit__tag.is-ok { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 40%, transparent); }
  .transit__lane {
    position: relative; width: clamp(48px, 8vw, 96px); height: 1px;
    background: var(--border);
  }
  .transit__pkg {
    position: absolute; top: 50%; left: 0;
    width: 7px; height: 7px; border-radius: var(--radius-full);
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    transform: translateY(-50%);
    animation: packet 3.2s var(--ease-expo) infinite;
  }
  @keyframes packet { 0% { left: 0%; opacity: 0; } 12% { opacity: 1; } 88% { opacity: 1; } 100% { left: 100%; opacity: 0; } }

  /* conteo a ciegas (3.0) */
  .count { display: inline-flex; align-items: baseline; gap: 0.7em; }
  .count em { font-style: normal; font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  .count i { font-style: normal; font-family: var(--font-mono); font-size: var(--text-xs); }
  .count__ok { color: var(--accent); }
  .count__bad { color: var(--danger); }

  /* ════ 04 · ARQUITECTURA (oscuro) ════ */
  .arch { padding-block: clamp(var(--space-xl), 14vh, var(--space-2xl)); }
  .flow {
    display: grid; grid-template-columns: 1fr auto 1.2fr auto 1fr;
    align-items: center; gap: var(--space-sm);
    margin-block: var(--space-lg);
  }
  .flow__node {
    display: flex; flex-direction: column; align-items: center; gap: 0.4em; text-align: center;
    padding: var(--space-md) var(--space-sm);
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
    border: 1px solid var(--border);
  }
  .flow__node--core {
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
    box-shadow: 0 0 40px color-mix(in srgb, var(--accent) 8%, transparent);
    padding-block: var(--space-lg);
  }
  .flow__node img { display: block; }
  .flow__ico { width: 2rem; height: 2rem; color: var(--accent); }
  .flow__ico svg { width: 100%; height: 100%; }
  .flow__name { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-sm); color: var(--text-primary); }
  .flow__tag { font-family: var(--font-mono); font-size: 0.65rem; color: var(--text-secondary); }
  .flow__lane { position: relative; height: 1px; min-width: 36px; background: color-mix(in srgb, var(--accent) 25%, var(--border)); }
  .flow__lane i {
    position: absolute; top: 50%; left: 0;
    width: 7px; height: 7px; border-radius: var(--radius-full);
    background: var(--accent); box-shadow: 0 0 10px var(--accent);
    transform: translateY(-50%);
    animation: packet 2.8s var(--ease-expo) infinite;
  }
  .flow__lane--d2 i { animation-delay: 1.4s; }

  .archvals { list-style: none; display: grid; grid-template-columns: 1fr; gap: var(--space-md); }
  .archval {
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
    display: grid; gap: 0.4em;
  }
  .archval__tag { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--accent); }
  .archval h3 { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-base); color: var(--text-primary); }
  .archval p { color: var(--text-secondary); font-size: var(--text-sm); line-height: 1.65; }

  /* ════ 05 · ESCALA: stats protagonistas ════ */
  .scalex { padding-top: clamp(var(--space-xl), 12vh, var(--space-2xl)); border-top: 1px solid var(--border); }
  .scalex__lead { color: var(--text-secondary); font-size: var(--text-base); margin-bottom: var(--space-lg); }
  .scalex__grid {
    display: grid; grid-template-columns: 1fr; gap: var(--space-lg);
    margin-bottom: clamp(var(--space-lg), 10vh, var(--space-xl));
  }
  .stat { display: grid; gap: 0.3em; }
  .stat__v {
    font-family: var(--font-heading); font-weight: 600;
    font-size: clamp(3rem, 7vw, 5.2rem); line-height: 1; letter-spacing: -0.04em;
    color: var(--text-primary);
  }
  .stat__v em { font-style: normal; font-variant-numeric: tabular-nums; }
  .stat__l { color: var(--text-secondary); font-size: var(--text-sm); max-width: 30ch; }

  /* ════ ROADMAP ════ */
  .roadmap { padding-block: var(--space-xl); }
  .roadmap__grid { display: grid; grid-template-columns: 1fr; gap: var(--space-lg); align-items: center; }

  .forecast {
    position: relative; overflow: hidden;
    padding: var(--space-md);
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
    border: 1px solid color-mix(in srgb, var(--accent) 16%, var(--border));
  }
  .badge {
    display: inline-flex; align-items: center; gap: 0.5em;
    font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--accent);
    padding: 0.45em 1em; border-radius: var(--radius-full);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    margin-bottom: var(--space-sm);
  }
  .badge i { width: 6px; height: 6px; border-radius: var(--radius-full); background: var(--accent); animation: chip-pulse 2s ease-in-out infinite; }
  .forecast h3 { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-xl); letter-spacing: -0.02em; color: var(--text-primary); margin-bottom: var(--space-sm); }
  .forecast h3 span { color: var(--accent); }
  .forecast p { color: var(--text-secondary); font-size: var(--text-sm); line-height: 1.7; max-width: 56ch; }
  .forecast__chart { position: relative; margin-top: var(--space-md); color: var(--accent); }
  .forecast__chart svg { display: block; width: 100%; height: 96px; }
  .forecast__dash { opacity: 0.85; }
  .forecast__label {
    position: absolute; right: 0; top: -0.4rem;
    font-family: var(--font-mono); font-size: var(--text-xs); color: var(--accent);
  }

  /* ════ FINALE ════ */
  .finale {
    position: relative;
    padding-block: clamp(var(--space-2xl), 22vh, 16rem);
    text-align: center;
    overflow: hidden;
    border-top: 1px solid var(--border);
  }
  /* Velo para contraste del texto sobre el shader */
  .finale::after {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: radial-gradient(60% 70% at 50% 50%, color-mix(in srgb, var(--bg-primary) 55%, transparent), color-mix(in srgb, var(--bg-primary) 82%, transparent));
  }
  .finale__inner {
    position: relative; z-index: 2;
    display: flex; flex-direction: column; align-items: center; gap: var(--space-md);
    max-width: 720px; margin-inline: auto;
  }
  .finale h2 {
    font-family: var(--font-heading); font-weight: 600;
    font-size: clamp(2.1rem, 5vw, 3.8rem); line-height: 1.04; letter-spacing: -0.035em;
    color: var(--text-primary);
  }
  .finale h2 .line { display: block; overflow: hidden; padding-bottom: 0.08em; margin-bottom: -0.08em; }
  .finale h2 em {
    font-style: normal;
    background: linear-gradient(100deg, var(--accent), var(--accent-hover));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .finale p { color: var(--text-secondary); font-size: var(--text-base); line-height: 1.7; max-width: 46ch; }
  .finale__meta { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.1em; color: var(--text-secondary); }

  /* ════ DESKTOP ════ */
  @media (min-width: 768px) {
    .hero__grid { grid-template-columns: 1fr 1.05fr; gap: var(--space-lg); align-items: center; }
    /* El visual sangra hasta el borde derecho del viewport y ocupa altura real */
    .hero__visual {
      height: min(76vh, 680px);
      margin-right: calc(50% - 50vw);
    }
    .visual { border-radius: var(--radius-lg) 0 0 var(--radius-lg); border-right: none; }

    /* Desafíos: narrativa sticky 1fr · ledger 1.2fr (asimétrico) */
    .desa { grid-template-columns: 1fr 1.2fr; gap: var(--space-xl); }
    .desa__aside { position: sticky; top: 12vh; }
    .ledger__row { grid-template-columns: 8rem 1fr; align-items: start; gap: var(--space-lg); }
    .ledger__ghost { text-align: center; }

    .archvals { grid-template-columns: repeat(3, 1fr); gap: var(--space-lg); }
    .scalex__grid { grid-template-columns: repeat(3, 1fr); }
    .roadmap__grid { grid-template-columns: 0.95fr 1.05fr; gap: var(--space-2xl); }
  }

  /* Recorrido pinneado — solo desktop con motion permitido (fallback: apilado) */
  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    .os { height: 300vh; }
    .os__stage { position: sticky; top: 0; height: 100vh; display: flex; align-items: center; }
    .os__inner { grid-template-columns: 0.62fr 1.38fr; gap: var(--space-2xl); align-items: center; width: 100%; margin-top: 0; }
    /* En desktop el título/descripción viven en el rail izquierdo → ocultar los del panel */
    .os__sn, .os__desc { display: none; }

    .os__rail { display: block; position: relative; padding-left: var(--space-md); align-self: center; }
    .os__rail ol { list-style: none; display: grid; gap: var(--space-lg); }
    .os__dot {
      display: grid; grid-template-columns: auto 1fr; gap: 0.9em; align-items: start;
      color: var(--text-primary); opacity: 0.4;
      transition: opacity 0.45s var(--ease-expo), transform 0.45s var(--ease-expo);
    }
    .os__dot.is-active { opacity: 1; transform: translateX(8px); }
    .os__dot.is-active .os__rn { text-shadow: 0 0 14px color-mix(in srgb, var(--accent) 65%, transparent); }
    .os__rn { font-family: var(--font-mono); font-weight: 400; font-size: var(--text-sm); color: var(--accent); padding-top: 0.25em; }
    .os__rtext { display: grid; gap: 0.35em; min-width: 0; }
    .os__rlabel {
      font-family: var(--font-heading); font-weight: 600; font-size: clamp(1.15rem, 1.7vw, 1.55rem);
      letter-spacing: -0.02em; line-height: 1.1;
    }
    /* La descripción se despliega bajo el título solo en el módulo activo */
    .os__rdesc {
      font-family: var(--font-body); font-weight: 400; font-size: var(--text-sm);
      line-height: 1.55; color: var(--text-secondary); max-width: 36ch;
      opacity: 0; max-height: 0; transform: translateY(-4px); overflow: hidden;
      transition: opacity 0.45s var(--ease-expo), max-height 0.55s var(--ease-expo), transform 0.45s var(--ease-expo);
    }
    .os__dot.is-active .os__rdesc { opacity: 1; max-height: 9em; transform: none; }
    .os__track { position: absolute; left: 0; top: 0.4em; bottom: 0.4em; width: 2px; background: color-mix(in srgb, var(--accent) 18%, var(--border)); border-radius: 2px; overflow: hidden; }
    .os__progress { position: absolute; inset: 0; background: var(--accent); transform: scaleY(0); transform-origin: top; box-shadow: 0 0 12px var(--accent); }
    .os__device { box-shadow: 0 40px 90px rgba(0,0,0,0.55), 0 0 60px color-mix(in srgb, var(--accent) 14%, transparent); }
    /* Panel más grande: ocupa más alto y la UI respira */
    .os__screens { position: relative; min-height: clamp(540px, 74vh, 740px); padding: 0; }
    .os__screen { position: absolute; inset: 0; padding: var(--space-md) var(--space-lg); align-content: center; }
    /* Escala tipográfica mayor dentro del mockup grande */
    .os__screen .mock__bar { font-size: var(--text-base); padding: var(--space-md); }
    .os__screen .mock__body { padding: var(--space-md) var(--space-md) var(--space-md); gap: 0.85em; }
    .os__screen .mock__row, .os__screen .mock__total { font-size: var(--text-base); }
    .os__screen .ocrow { font-size: var(--text-sm); gap: 0.7em; }
    .os__screen .approve__step { font-size: var(--text-sm); }
    .os__screen .mock__total strong { font-size: var(--text-xl); }
  }

  /* Planning: diagrama vivo pinneado (productos → bodega ordenada → nodos conectados) */
