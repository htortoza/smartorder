---
// src/pages/centro-de-ayuda/proveedores.astro — Manual para proveedores (SmartOrder).
// Público EXTERNO: explica al proveedor cómo revisar y responder una cotización.
// Contenido fiel a Conocimiento/ (texto del flujo + captura "Revisión de Cotización").
// Ruta estática → tiene prioridad sobre [modulo].astro.
import Layout from '../../layouts/Layout.astro';
import site from '../../../contracts/site.json';
import { withBase } from '../../lib/path.js';

const seo = {
  title: 'Manual para proveedores — SmartOrder',
  description: 'Cómo revisar y responder una cotización en SmartOrder: recibir la solicitud, aprobar o rechazar productos, adjuntar mensajes y llegar a un acuerdo con la tienda.',
  googleFontsUrl: 'https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap',
  schemaData: {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'Cómo responder una cotización en SmartOrder (proveedores)',
    description: 'Guía paso a paso para que un proveedor revise y responda una solicitud de cotización recibida desde SmartOrder.',
  },
};

// Pasos del flujo (índice lateral + scrollspy).
const steps = [
  { id: 'correo',     n: '1', title: 'Recibe el correo de solicitud' },
  { id: 'revision',   n: '2', title: 'Abre la revisión de la cotización' },
  { id: 'responder',  n: '3', title: 'Aprueba o rechaza cada producto' },
  { id: 'enviar',     n: '4', title: 'Finaliza y envía tu respuesta' },
  { id: 'despues',    n: '5', title: 'Qué ocurre después' },
];
---

<Layout
  title={seo.title}
  description={seo.description}
  googleFontsUrl={seo.googleFontsUrl}
  schemaData={seo.schemaData}
>
  <div class="doc container">
    <nav class="doc-crumbs" aria-label="Ruta">
      <a href={withBase('/centro-de-ayuda')}>Centro de ayuda</a>
      <span aria-hidden="true">/</span>
      <span>Manual para proveedores</span>
    </nav>

    <div class="doc-layout">
      <!-- Índice de pasos -->
      <aside class="doc-side">
        <button class="doc-side__toggle" type="button" aria-expanded="false" aria-controls="doc-index">
          <span>Pasos</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <nav id="doc-index" class="doc-side__nav" aria-label="Pasos del proceso">
          <ul role="list" class="doc-side__list">
            {steps.map((s) => (
              <li><a href={`#${s.id}`} class="doc-side__link"><span class="doc-side__num">{s.n}</span>{s.title}</a></li>
            ))}
          </ul>
        </nav>
      </aside>

      <!-- Contenido -->
      <article class="doc-content">
        <header class="doc-head">
          <span class="doc-tag">Para tus proveedores</span>
          <h1>Cómo responder una cotización</h1>
          <p class="doc-lead">
            Cuando una tienda genera una solicitud de compra hacia usted, SmartOrder le envía la
            cotización por correo para que la revise y responda. Esta guía explica ese proceso de
            principio a fin.
          </p>
        </header>

        <!-- Paso 1 -->
        <section id="correo" class="step" aria-labelledby="correo-h">
          <div class="step__head"><span class="step__n">1</span><h2 id="correo-h">Recibe el correo de solicitud</h2></div>
          <p>Recibirá un correo avisándole de una nueva solicitud de compra que requiere su atención. Incluye la empresa y la tienda solicitante, y un botón para abrir el detalle.</p>

          <div class="mail" role="img" aria-label="Ejemplo del correo de solicitud de productos que recibe el proveedor">
            <p class="mail__title">Solicitud de Productos</p>
            <p class="mail__sub">Has recibido una nueva solicitud de compra que requiere tu atención</p>
            <p class="mail__p">Estimado proveedor,</p>
            <p class="mail__p"><strong>Fuente de sosa</strong> ha generado una nueva solicitud de compra.</p>
            <dl class="mail__meta">
              <div><dt>Nombre tienda</dt><dd>Tienda Providencia</dd></div>
              <div><dt>RUT tienda</dt><dd>11111111-1</dd></div>
            </dl>
            <p class="mail__p">Por favor, revisa los detalles y procede con la aprobación o rechazo de la solicitud.</p>
            <span class="mail__btn">Ver Solicitud</span>
            <p class="mail__foot">Por favor, confirma la disponibilidad y fecha de entrega lo antes posible.</p>
          </div>
          <p class="step__note">Pulse <strong>“Ver Solicitud”</strong> para abrir el detalle completo, donde podrá aceptar o rechazar los productos.</p>
        </section>

        <!-- Paso 2 -->
        <section id="revision" class="step" aria-labelledby="revision-h">
          <div class="step__head"><span class="step__n">2</span><h2 id="revision-h">Abre la revisión de la cotización</h2></div>
          <p>Se abre la pantalla <strong>Revisión de Cotización</strong>. En la parte superior verá tres bloques de contexto:</p>
          <ul role="list" class="doc-bullets">
            <li><strong>Solicitante de la cotización</strong> — empresa que solicita, su RUT y ubicación.</li>
            <li><strong>Proveedor evaluador</strong> — sus datos como proveedor (RUT, email, ciudad).</li>
            <li><strong>Destino de la cotización</strong> — tienda de entrega y la <strong>fecha de entrega</strong> solicitada.</li>
          </ul>
          <p>Debajo está la tabla de <strong>Productos</strong>, con la cantidad solicitada, el precio unitario, el subtotal y las acciones por producto. Puede filtrar por estado (<em>Pendientes</em>, <em>Aprobados</em>, <em>Rechazados</em>) y ver el resumen de totales al pie.</p>

          <figure class="shot">
            <img src={withBase('/images/proveedores/revision-cotizacion.webp')} width="1600" height="889" alt="Pantalla Revisión de Cotización: bloques de solicitante, proveedor y destino; tabla de productos con acciones Aprobar y Rechazar; y resumen de totales." loading="lazy" decoding="async" />
            <figcaption>Pantalla “Revisión de Cotización” que ve el proveedor.</figcaption>
          </figure>
        </section>

        <!-- Paso 3 -->
        <section id="responder" class="step" aria-labelledby="responder-h">
          <div class="step__head"><span class="step__n">3</span><h2 id="responder-h">Aprueba o rechaza cada producto</h2></div>
          <ul role="list" class="doc-bullets">
            <li>Cada producto se responde <strong>de forma individual</strong>: puede <strong>Aprobar</strong> o <strong>Rechazar</strong>.</li>
            <li>Al rechazar un producto, puede <strong>adjuntar un mensaje</strong> por cada producto rechazado para explicar el motivo (por ejemplo, sin stock o precio a revisar).</li>
            <li>El <strong>resumen de totales</strong> se actualiza mostrando los productos aprobados y rechazados a medida que responde.</li>
          </ul>
        </section>

        <!-- Paso 4 -->
        <section id="enviar" class="step" aria-labelledby="enviar-h">
          <div class="step__head"><span class="step__n">4</span><h2 id="enviar-h">Finaliza y envía tu respuesta</h2></div>
          <p>Cuando termine de revisar los productos, en <strong>Finalizar revisión</strong> pulse <strong>“Enviar”</strong> para devolver su respuesta a la tienda.</p>
        </section>

        <!-- Paso 5 -->
        <section id="despues" class="step" aria-labelledby="despues-h">
          <div class="step__head"><span class="step__n">5</span><h2 id="despues-h">Qué ocurre después</h2></div>
          <p><strong>Si aprueba los productos:</strong> la cotización aprobada genera la <strong>orden de compra</strong> y el pedido pasa a estado <strong>“en camino”</strong>.</p>
          <p><strong>Si rechaza un producto</strong>, la tienda lo verá como rechazado y podrá:</p>
          <ul role="list" class="doc-bullets">
            <li>Intentar con <strong>otro proveedor</strong>, si alguno tiene el producto.</li>
            <li>Si ningún proveedor lo tiene, el producto <strong>se elimina</strong> de la solicitud general.</li>
            <li>O <strong>cambiar la cantidad</strong> del producto.</li>
          </ul>
          <p class="step__note">Si la tienda cambia la cantidad del producto que usted rechazó, recibirá <strong>un nuevo correo con el mismo formulario</strong> y la cantidad actualizada — así hasta llegar a un acuerdo.</p>
        </section>

        <aside class="doc-cta">
          <p>¿Dudas sobre una solicitud recibida?</p>
          <a href={site.orderUrl} class="doc-cta__btn">Contactar a la tienda →</a>
        </aside>
      </article>
    </div>
  </div>
</Layout>

<style>
  .doc { padding-block: var(--space-lg) var(--space-xl); }
  .doc-crumbs { display: flex; gap: 0.6rem; align-items: center; font-size: var(--text-sm); color: var(--text-secondary); margin-bottom: var(--space-md); }
  .doc-crumbs a { color: var(--text-secondary); text-decoration: none; }
  .doc-crumbs a:hover { color: var(--accent); }

  .doc-layout { display: grid; grid-template-columns: 1fr; gap: var(--space-md); align-items: start; }

  /* Índice de pasos */
  .doc-side__toggle {
    display: flex; width: 100%; align-items: center; justify-content: space-between; gap: var(--space-xs);
    padding: 0.75rem var(--space-sm); min-height: 48px;
    background: var(--bg-secondary); border: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
    border-radius: var(--radius-md); color: var(--text-primary);
    font-family: var(--font-body); font-size: var(--text-sm); font-weight: 500; cursor: pointer;
    position: sticky; top: 0.75rem; z-index: var(--z-above);
  }
  .doc-side__toggle svg { transition: transform var(--transition-fast); }
  .doc-side[data-open] .doc-side__toggle svg { transform: rotate(180deg); }
  .doc-side__nav {
    display: none; margin-top: var(--space-sm); padding: var(--space-sm);
    background: color-mix(in srgb, var(--bg-secondary) 70%, transparent);
    border: 1px solid color-mix(in srgb, var(--border) 40%, transparent); border-radius: var(--radius-md);
  }
  .doc-side[data-open] .doc-side__nav { display: block; }
  .doc-side__list { list-style: none; display: grid; gap: 2px; }
  .doc-side__link {
    display: flex; align-items: baseline; gap: 0.5rem; padding: 0.5rem 0.6rem; min-height: 36px; border-radius: var(--radius-sm);
    color: var(--text-primary); text-decoration: none; font-size: var(--text-sm); line-height: 1.35;
    border-left: 2px solid transparent; transition: color var(--transition-fast), background-color var(--transition-fast);
  }
  .doc-side__num { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--accent); }
  .doc-side__link:hover { color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, transparent); }
  .doc-side__link[aria-current="true"] { color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, transparent); border-left-color: var(--accent); }

  /* Contenido */
  .doc-content { min-width: 0; max-width: 760px; }
  .doc-head { margin-bottom: var(--space-md); }
  .doc-tag {
    display: inline-block; font-family: var(--font-mono); font-size: var(--text-xs);
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent);
    padding: 0.3rem 0.7rem; border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: var(--radius-full); margin-bottom: var(--space-sm);
  }
  .doc-head h1 { font-family: var(--font-heading); font-weight: 600; font-size: clamp(2rem, 5vw, 3rem); line-height: 1.08; letter-spacing: -0.02em; }
  .doc-lead { font-size: var(--text-lg); line-height: 1.6; color: var(--text-secondary); margin-top: var(--space-sm); }

  .doc-content p { font-size: var(--text-base); line-height: 1.65; color: var(--text-primary); }
  .doc-content p + p { margin-top: var(--space-sm); }
  .doc-content strong { font-weight: 500; }

  /* Pasos */
  .step { scroll-margin-top: 5.5rem; margin-top: var(--space-lg); padding-top: var(--space-md); border-top: 1px solid color-mix(in srgb, var(--border) 30%, transparent); }
  .step:first-of-type { border-top: none; padding-top: 0; }
  .step__head { display: flex; align-items: center; gap: var(--space-sm); margin-bottom: var(--space-sm); }
  .step__n {
    display: grid; place-items: center; flex-shrink: 0;
    width: 2.2rem; height: 2.2rem; border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    font-family: var(--font-mono); color: var(--accent); font-size: var(--text-base);
  }
  .step h2 { font-family: var(--font-heading); font-weight: 500; font-size: var(--text-xl); letter-spacing: -0.01em; }
  .step__note {
    margin-top: var(--space-sm); padding: var(--space-sm);
    background: color-mix(in srgb, var(--accent) 6%, var(--bg-secondary));
    border-left: 2px solid var(--accent); border-radius: 0 var(--radius-md) var(--radius-md) 0;
    color: var(--text-secondary) !important;
  }

  .doc-bullets { list-style: none; display: grid; gap: 0.6rem; margin-top: var(--space-sm); }
  .doc-bullets > li { position: relative; padding-left: 1.4rem; font-size: var(--text-base); line-height: 1.65; color: var(--text-primary); }
  .doc-bullets > li::before { content: ""; position: absolute; left: 0.15rem; top: 0.62em; width: 6px; height: 6px; border-radius: var(--radius-full); background: var(--accent); }

  /* Reproducción del correo */
  .mail {
    margin-top: var(--space-md); padding: var(--space-md);
    background: var(--surface-light-2); color: var(--text-on-light);
    border-radius: var(--radius-lg); border: 1px solid var(--border-on-light);
    max-width: 520px;
  }
  .mail__title { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-xl); color: var(--text-on-light) !important; }
  .mail__sub { color: var(--text-on-light-soft) !important; margin: 0.25rem 0 var(--space-sm); font-size: var(--text-sm) !important; }
  .mail__p { color: var(--text-on-light) !important; font-size: var(--text-sm) !important; }
  .mail__p strong { font-weight: 600; }
  .mail__meta { display: grid; gap: 0.4rem; margin: var(--space-sm) 0; padding: var(--space-sm); background: var(--surface-light); border-radius: var(--radius-md); }
  .mail__meta div { display: flex; justify-content: space-between; gap: var(--space-sm); }
  .mail__meta dt { font-size: var(--text-xs); color: var(--text-on-light-soft); text-transform: uppercase; letter-spacing: 0.06em; }
  .mail__meta dd { font-size: var(--text-sm); color: var(--text-on-light); font-weight: 500; }
  .mail__btn {
    display: inline-block; margin: var(--space-xs) 0; padding: 0.7rem 1.4rem;
    background: var(--accent-ink); color: #fff; border-radius: var(--radius-md);
    font-weight: 500; font-size: var(--text-sm);
  }
  .mail__foot { color: var(--text-on-light-soft) !important; font-size: var(--text-xs) !important; margin-top: var(--space-sm); }

  /* Captura */
  .shot { margin: var(--space-md) 0 0; }
  .shot :global(img) {
    display: block; width: 100%; height: auto;
    border-radius: var(--radius-lg); border: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
    background: var(--bg-secondary);
  }
  .shot figcaption { margin-top: var(--space-xs); font-size: var(--text-sm); color: var(--text-secondary); text-align: center; }

  /* CTA */
  .doc-cta {
    margin-top: var(--space-lg); padding: var(--space-md); text-align: center;
    background: color-mix(in srgb, var(--accent) 6%, var(--bg-secondary));
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent); border-radius: var(--radius-lg);
  }
  .doc-cta p { font-size: var(--text-lg); color: var(--text-primary); margin-bottom: var(--space-sm); }
  .doc-cta__btn {
    display: inline-block; padding: 0.8rem 1.6rem; background: var(--accent); color: var(--bg-primary);
    font-weight: 600; text-decoration: none; border-radius: var(--radius-full); transition: background-color var(--transition-fast);
  }
  .doc-cta__btn:hover { background: var(--accent-hover); }

  @media (min-width: 1024px) {
    .doc-layout { grid-template-columns: 240px 1fr; gap: var(--space-lg); }
    .doc-side { position: sticky; top: var(--space-lg); max-height: calc(100vh - var(--space-lg) * 2); overflow-y: auto; }
    .doc-side__toggle { display: none; }
    .doc-side__nav { display: block; margin-top: 0; background: transparent; border: none; padding: 0; }
  }
</style>

<script>
  // Índice de pasos: toggle móvil + scrollspy.
  function initSteps() {
    const aside = document.querySelector('.doc-side');
    const nav = document.getElementById('doc-index');
    const content = document.querySelector('.doc-content');
    if (!aside || !nav || !content) return;

    const toggle = aside.querySelector('.doc-side__toggle');
    toggle?.addEventListener('click', () => {
      const open = aside.hasAttribute('data-open');
      open ? aside.removeAttribute('data-open') : aside.setAttribute('data-open', '');
      toggle.setAttribute('aria-expanded', String(!open));
    });
    nav.addEventListener('click', (ev) => {
      if ((ev.target as HTMLElement).closest('a') && window.matchMedia('(max-width: 1023px)').matches) {
        aside.removeAttribute('data-open');
        toggle?.setAttribute('aria-expanded', 'false');
      }
    });

    const links = new Map<string, HTMLAnchorElement>();
    nav.querySelectorAll('a[href^="#"]').forEach((a) => links.set(a.getAttribute('href')!.slice(1), a as HTMLAnchorElement));
    const sections = Array.from(content.querySelectorAll('.step'));
    let current = '';
    const spy = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          const id = (e.target as HTMLElement).id;
          if (id === current) continue;
          links.get(current)?.removeAttribute('aria-current');
          links.get(id)?.setAttribute('aria-current', 'true');
          current = id;
        }
      }
    }, { rootMargin: '-20% 0px -70% 0px' });
    sections.forEach((s) => spy.observe(s));
  }

  document.addEventListener('astro:page-load', initSteps);
</script>
