---
// src/pages/centro-de-ayuda/recursos.astro — Recursos descargables + tutorial plantilla de carga.
import Layout from '../../layouts/Layout.astro';
import site from '../../../contracts/site.json';
import { withBase } from '../../lib/path.js';

const seo = {
  title: 'Recursos — Plantilla de carga de productos | SmartOrder',
  description: 'Descarga la plantilla oficial de productos SmartOrder y aprende paso a paso cómo rellenarla: productos simples, recetas, códigos y errores comunes.',
  googleFontsUrl: 'https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap',
  schemaData: {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'Cómo rellenar la Plantilla de Carga de Productos SmartOrder',
    description: 'Guía completa para cargar productos en SmartOrder: productos sin receta, productos con receta, códigos e identificadores.',
  },
};

const sections = [
  { id: 'descarga',   n: '↓', title: 'Descarga la plantilla' },
  { id: 'intro',      n: '1', title: 'Cómo funciona' },
  { id: 'sin-receta', n: '2', title: 'Productos sin receta' },
  { id: 'con-receta', n: '3', title: 'Productos con receta' },
  { id: 'codigos',    n: '4', title: 'Códigos universales' },
  { id: 'ejemplos',   n: '5', title: 'Ejemplos prácticos' },
  { id: 'errores',    n: '6', title: 'Errores comunes' },
];
---

<Layout
  title={seo.title}
  description={seo.description}
  googleFontsUrl={seo.googleFontsUrl}
  schemaData={seo.schemaData}
>
  <div class="doc container">
    <nav class="doc-crumbs" aria-label="Ruta">
      <a href={withBase('/centro-de-ayuda')}>Centro de ayuda</a>
      <span aria-hidden="true">/</span>
      <span>Recursos</span>
    </nav>

    <div class="doc-layout">
      <!-- Índice lateral -->
      <aside class="doc-side">
        <button class="doc-side__toggle" type="button" aria-expanded="false" aria-controls="doc-index">
          <span>En esta página</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <nav id="doc-index" class="doc-side__nav" aria-label="Secciones">
          <ul role="list" class="doc-side__list">
            {sections.map((s) => (
              <li>
                <a href={`#${s.id}`} class="doc-side__link">
                  <span class="doc-side__num">{s.n}</span>
                  {s.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>

      <!-- Contenido principal -->
      <article class="doc-content">
        <header class="doc-head">
          <span class="doc-tag">Recursos</span>
          <h1>Plantilla de carga de productos</h1>
          <p class="doc-lead">
            Descarga la plantilla oficial y sigue esta guía para cargar todos tus productos en
            SmartOrder correctamente — desde insumos simples hasta recetas multi-nivel.
          </p>
        </header>

        <!-- ── Descarga ── -->
        <section id="descarga" class="step step--download" aria-labelledby="descarga-h">
          <h2 id="descarga-h" class="sr-only">Descarga la plantilla</h2>
          <div class="download-card">
            <div class="download-card__icon" aria-hidden="true">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
                <polyline points="10 9 9 9 8 9"/>
              </svg>
            </div>
            <div class="download-card__info">
              <p class="download-card__name">Planilla_de_productos_Smart_Order.xlsx</p>
              <p class="download-card__meta">Microsoft Excel · Plantilla oficial SmartOrder</p>
            </div>
            <a
              href={withBase('/recursos/Planilla_de_productos_Smart_Order.xlsx')}
              download="Planilla_de_productos_Smart_Order.xlsx"
              class="download-card__btn"
              aria-label="Descargar plantilla Excel de productos SmartOrder"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Descargar
            </a>
          </div>
        </section>

        <!-- ── 1. Cómo funciona ── -->
        <section id="intro" class="step" aria-labelledby="intro-h">
          <div class="step__head">
            <span class="step__n">1</span>
            <h2 id="intro-h">Cómo funciona la plantilla</h2>
          </div>

          <p>Esta planilla sirve para cargar productos y recetas de una sola vez. La información se transforma automáticamente en datos para la base de datos. <strong>No necesitas saber de bases de datos ni de SQL</strong>: solo llena las celdas como una lista de Excel.</p>

          <p>Hay <strong>solo dos hojas para cargar productos</strong>. Cada producto va en una sola hoja, según si tiene receta o no:</p>

          <div class="diagram" aria-label="Hojas de la plantilla">
            <div class="diagram__row diagram__row--active">
              <span class="diagram__n">01</span>
              <div class="diagram__body">
                <span class="diagram__label">Productos SIN Receta</span>
                <span class="diagram__action diagram__action--fill">Completar</span>
              </div>
              <span class="diagram__desc">Insumos y productos que compras o vendes tal cual</span>
            </div>
            <div class="diagram__row diagram__row--active">
              <span class="diagram__n">02</span>
              <div class="diagram__body">
                <span class="diagram__label">Productos CON Receta</span>
                <span class="diagram__action diagram__action--fill">Completar</span>
              </div>
              <span class="diagram__desc">Productos fabricados a partir de otros</span>
            </div>
            <div class="diagram__row diagram__row--active">
              <span class="diagram__n">03</span>
              <div class="diagram__body">
                <span class="diagram__label">Catálogos</span>
                <span class="diagram__action diagram__action--optional">Solo si agregas opciones</span>
              </div>
              <span class="diagram__desc">Agrega unidades de medida o tipos de código nuevos</span>
            </div>
            <div class="diagram__row">
              <span class="diagram__n">04</span>
              <div class="diagram__body">
                <span class="diagram__label">Instrucciones</span>
                <span class="diagram__action diagram__action--readonly">No tocar</span>
              </div>
              <span class="diagram__desc">Referencia interna del archivo</span>
            </div>
          </div>

          <div class="callout callout--warning">
            <strong>Importante:</strong> No cambies el nombre de las hojas ni el orden de las columnas — la carga a la base de datos depende de que estén exactamente así.
          </div>

          <div class="callout callout--tip">
            <strong>Recomendación:</strong> Empieza por los productos SIN receta. Una vez ingresados, los verás disponibles en los menús desplegables de la hoja CON Receta.
          </div>
        </section>

        <!-- ── 2. Sin Receta ── -->
        <section id="sin-receta" class="step" aria-labelledby="sin-receta-h">
          <div class="step__head">
            <span class="step__n">2</span>
            <h2 id="sin-receta-h">Productos sin receta</h2>
          </div>
          <p>Usa esta hoja para todo producto que se vende o se compra tal cual, <strong>sin fabricarse a partir de otros productos</strong>: una bebida, una botella de vino, un insumo que compras ya listo.</p>
          <p>Las celdas en <strong>amarillo claro</strong> dentro del Excel (<code>NOMBRE</code> y <code>CODIGO EXTERNO</code>) son las obligatorias — el resto es opcional.</p>

          <ol role="list" class="steps-list">
            <li class="steps-list__item">
              <span class="steps-list__n">1</span>
              <div>
                <h3>Abre la hoja "Productos SIN Receta"</h3>
                <p>En la parte inferior del Excel verás varias pestañas. Haz clic en "Productos SIN Receta".</p>
              </div>
            </li>
            <li class="steps-list__item">
              <span class="steps-list__n">2</span>
              <div>
                <h3>Completa a partir de la fila 3</h3>
                <p>Las filas 1 y 2 son encabezados — no las modifiques. Cada fila a partir de la 3 es un producto.</p>
              </div>
            </li>
            <li class="steps-list__item">
              <span class="steps-list__n">3</span>
              <div>
                <h3>Completa los campos</h3>
                <div class="table-wrap">
                  <table class="data-table">
                    <thead>
                      <tr>
                        <th>Campo</th>
                        <th>Ejemplo</th>
                        <th>Notas</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td><code class="req">NOMBRE</code></td>
                        <td>Botella Pisco Alto del Carmen</td>
                        <td>Puede repetirse (no recomendado)</td>
                      </tr>
                      <tr>
                        <td><code class="req">CODIGO EXTERNO</code></td>
                        <td>VT-BAR-ALTCA</td>
                        <td>Único en toda la plantilla. Inventa uno si no tienes.</td>
                      </tr>
                      <tr>
                        <td><code>UNIDAD DE MEDIDA</code></td>
                        <td>unidad (o botella)</td>
                        <td>Desplegable. Agrega nuevas en la hoja Catálogos.</td>
                      </tr>
                      <tr>
                        <td><code>COSTO ESTIMADO</code></td>
                        <td>8500</td>
                        <td>Solo número, sin símbolos. Puede quedar vacío.</td>
                      </tr>
                      <tr>
                        <td><code>DESCRIPCION</code></td>
                        <td>70 cl, alcohol 42°</td>
                        <td>Texto libre, opcional.</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </li>
            <li class="steps-list__item">
              <span class="steps-list__n">4</span>
              <div>
                <h3>Agrega códigos universales si aplica <span class="badge badge--optional">Opcional</span></h3>
                <p>En <code>Tipo Codigo 1</code> elige el estándar desde el desplegable (ej.: "GTIN/EAN-13"). En <code>Codigo 1</code> escribe el valor. Puedes agregar hasta 3 códigos distintos por producto.</p>
              </div>
            </li>
          </ol>

          <div class="callout callout--example">
            <p class="callout__title">Ejemplo completo — Botella de vino</p>
            <div class="table-wrap">
              <table class="data-table data-table--sm">
                <thead>
                  <tr>
                    <th>NOMBRE</th>
                    <th>CODIGO EXTERNO</th>
                    <th>UNIDAD DE MEDIDA</th>
                    <th>COSTO ESTIMADO</th>
                    <th>DESCRIPCION</th>
                    <th>Tipo Codigo 1</th>
                    <th>Codigo 1</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Vino Latitud Sur Cabernet</td>
                    <td><code>VT-WIN-LATCS</code></td>
                    <td>botella</td>
                    <td>6500</td>
                    <td>750 ml, tinto</td>
                    <td>GTIN/EAN-13</td>
                    <td>7801108203047</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div class="callout callout--warning">
            <strong>Importante:</strong> El <code>CODIGO EXTERNO</code> debe ser único. No puede haber dos productos con el mismo código, ni entre hojas. Usa un patrón consistente, ej.: <code>PREFIJO-CATEGORIA-CODIGO</code>.
          </div>
        </section>

        <!-- ── 3. Con Receta ── -->
        <section id="con-receta" class="step" aria-labelledby="con-receta-h">
          <div class="step__head">
            <span class="step__n">3</span>
            <h2 id="con-receta-h">Productos con receta</h2>
          </div>
          <p>Usa esta hoja <strong>solo para productos que fabricas</strong> usando otros como ingredientes: una pizza hecha con masa, queso y salsa; o una bolsa de carne armada con varios cortes. Todo producto en esta hoja usa receta automáticamente — no hace falta marcar ninguna opción "Usa Receta".</p>

          <div class="callout callout--warning">
            <strong>Antes de empezar:</strong> En el campo Ingrediente solo aparecen productos que ya existan en alguna de las dos hojas. El nombre debe coincidir exactamente — mayúsculas, espacios y tildes incluidos.
          </div>

          <ol role="list" class="steps-list">
            <li class="steps-list__item">
              <span class="steps-list__n">1</span>
              <div>
                <h3>Abre la hoja "Productos CON Receta"</h3>
              </div>
            </li>
            <li class="steps-list__item">
              <span class="steps-list__n">2</span>
              <div>
                <h3>Completa los datos del producto</h3>
                <p>Igual que en SIN Receta: nombre, código externo, unidad de medida, costo, descripción y códigos si aplica.</p>
              </div>
            </li>
            <li class="steps-list__item">
              <span class="steps-list__n">3</span>
              <div>
                <h3>Completa los ingredientes y sus cantidades</h3>
                <p>Usa los pares de columnas <code>Ingrediente 1 / Cantidad 1</code>, <code>Ingrediente 2 / Cantidad 2</code>, etc.</p>
                <div class="table-wrap">
                  <table class="data-table">
                    <thead>
                      <tr>
                        <th>Campo</th>
                        <th>Ejemplo</th>
                        <th>Notas</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td><code>Ingrediente 1</code></td>
                        <td>Masa de pizza</td>
                        <td>Desplegable. Debe coincidir exactamente con el nombre registrado.</td>
                      </tr>
                      <tr>
                        <td><code>Cantidad 1</code></td>
                        <td>0.3</td>
                        <td>Número con punto decimal. Cuánto de ese ingrediente lleva 1 unidad.</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
                <div class="callout callout--tip" style="margin-top: var(--space-sm)">
                  <strong>La cantidad es "por unidad del producto final":</strong> si tu pizza lleva 0.3 kg de masa, cada pizza que se produzca descontará 0.3 kg de masa del inventario.
                </div>
              </div>
            </li>
            <li class="steps-list__item">
              <span class="steps-list__n">4</span>
              <div>
                <h3>Agrega todos los ingredientes que necesites</h3>
                <p>La plantilla soporta hasta 10 ingredientes por fila. Si necesitas más, copia el patrón de columnas.</p>
              </div>
            </li>
          </ol>

          <div class="callout callout--example">
            <p class="callout__title">Ejemplo completo — Pizza Margarita</p>
            <div class="table-wrap">
              <table class="data-table data-table--sm">
                <thead>
                  <tr>
                    <th>NOMBRE</th>
                    <th>CODIGO EXTERNO</th>
                    <th>UND.</th>
                    <th>COSTO</th>
                    <th>Ingrediente 1</th>
                    <th>Cantidad 1</th>
                    <th>Ingrediente 2</th>
                    <th>Cantidad 2</th>
                    <th>Ingrediente 3</th>
                    <th>Cantidad 3</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Pizza Margarita</td>
                    <td><code>VT-PIZ-MAR</code></td>
                    <td>unidad</td>
                    <td>7500</td>
                    <td>Masa de pizza</td>
                    <td>0.3</td>
                    <td>Queso mozzarella</td>
                    <td>0.15</td>
                    <td>Salsa de tomate</td>
                    <td>0.1</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <h3>Recetas de múltiples niveles</h3>
          <p>Un ingrediente puede ser, a su vez, un producto CON receta:</p>
          <ul role="list" class="doc-bullets">
            <li><strong>Nivel 1:</strong> "Bolsa de Vacuno" = Caja Lomo + Posta Negra + Asiento</li>
            <li><strong>Nivel 2:</strong> "Brasero 4P" = Bolsa de Vacuno + Bolsa de Cerdo + Bolsa de Chorizo + Bolsa de Prieta</li>
          </ul>
          <p>Cuando se vende un "Brasero 4P", SmartOrder lo descompone automáticamente en cascada hasta descontar cada insumo del inventario.</p>
        </section>

        <!-- ── 4. Códigos ── -->
        <section id="codigos" class="step" aria-labelledby="codigos-h">
          <div class="step__head">
            <span class="step__n">4</span>
            <h2 id="codigos-h">Códigos universales</h2>
          </div>
          <p>Sección <span class="badge badge--optional">Opcional</span> disponible en ambas hojas. Sirve para guardar los <strong>códigos universales</strong> del producto: estándares internacionales que lo identifican de manera única en cualquier parte del mundo.</p>

          <h3>Tipos disponibles</h3>
          <p>El desplegable de <code>Tipo Codigo</code> incluye los estándares reconocidos internacionalmente:</p>
          <ul role="list" class="doc-bullets">
            <li><code>GTIN/EAN-13</code> — código de barras estándar de producto</li>
            <li><code>GTIN/EAN-8</code> — versión corta, para envases pequeños</li>
            <li><code>GTIN/UPC-A</code> — estándar norteamericano</li>
            <li><code>GTIN-14</code> — para cajas o unidades logísticas</li>
            <li><code>PLU</code> — código de producto a granel (frutas, verduras)</li>
            <li><code>SSCC</code> — identificador de unidad logística/pallet</li>
            <li><code>ISBN</code> — libros y publicaciones</li>
            <li><code>GS1-128</code> — código de barras con datos variables (lote, fecha)</li>
            <li><code>GIAI</code> — identificador de activo individual</li>
          </ul>

          <h3>Cómo usarla</h3>
          <p>Tienes <strong>3 pares de columnas</strong> por producto:</p>
          <div class="field-group">
            <ul role="list" class="field-list">
              <li><code>Tipo Codigo 1</code> + <code>Codigo 1</code></li>
              <li><code>Tipo Codigo 2</code> + <code>Codigo 2</code></li>
              <li><code>Tipo Codigo 3</code> + <code>Codigo 3</code></li>
            </ul>
          </div>

          <ol role="list" class="steps-list">
            <li class="steps-list__item">
              <span class="steps-list__n">1</span>
              <div>
                <h3>Haz clic en el desplegable de "Tipo Codigo 1"</h3>
                <p>Verás las opciones: GTIN/EAN-13, GTIN/EAN-8, GTIN/UPC-A, GTIN-14, PLU, SSCC, ISBN, GS1-128, GIAI.</p>
              </div>
            </li>
            <li class="steps-list__item">
              <span class="steps-list__n">2</span>
              <div>
                <h3>Elige el estándar que corresponda</h3>
              </div>
            </li>
            <li class="steps-list__item">
              <span class="steps-list__n">3</span>
              <div>
                <h3>Escribe el valor en "Codigo 1"</h3>
                <p>Por ejemplo, si elegiste "GTIN/EAN-13", escribe el número de 13 dígitos.</p>
              </div>
            </li>
          </ol>

          <div class="callout callout--example">
            <p class="callout__title">Ejemplo</p>
            <div class="table-wrap">
              <table class="data-table data-table--sm">
                <thead>
                  <tr>
                    <th>Tipo Codigo 1</th>
                    <th>Codigo 1</th>
                    <th>Tipo Codigo 2</th>
                    <th>Codigo 2</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>GTIN/EAN-13</td>
                    <td>7801108203047</td>
                    <td>PLU</td>
                    <td>4011</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>Si necesitas más de 3 códigos por producto, agrega columnas copiando el patrón (<code>Tipo Codigo 4</code>, <code>Codigo 4</code>…) o escríbenos.</p>

          <h3>Agregar tipos de código o unidades nuevas</h3>
          <p>La hoja <strong>Catálogos</strong> define las listas desplegables de las otras hojas: unidades de medida y tipos de código (columna <code>CODIGOS UNIVERSALES</code>). Si necesitas una opción que no está en la lista, escríbela en una fila nueva de esa hoja — el menú desplegable se actualiza solo.</p>
        </section>

        <!-- ── 5. Ejemplos ── -->
        <section id="ejemplos" class="step" aria-labelledby="ejemplos-h">
          <div class="step__head">
            <span class="step__n">5</span>
            <h2 id="ejemplos-h">Ejemplos prácticos</h2>
          </div>

          <h3>Ejemplo A — Bodega de bebidas</h3>

          <p class="step__sublabel">Paso 1: productos simples en "Productos SIN Receta"</p>
          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>NOMBRE</th>
                  <th>CODIGO EXTERNO</th>
                  <th>UNIDAD DE MEDIDA</th>
                  <th>COSTO ESTIMADO</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Botella Pisco Alto del Carmen</td>
                  <td><code>BE-PIS-ALTCA</code></td>
                  <td>botella</td>
                  <td>8 500</td>
                </tr>
                <tr>
                  <td>Vino Latitud Sur Cabernet</td>
                  <td><code>BE-VIN-LATCS</code></td>
                  <td>botella</td>
                  <td>6 500</td>
                </tr>
                <tr>
                  <td>Cerveza Kunstmann Lager</td>
                  <td><code>BE-CER-KUNL</code></td>
                  <td>botella</td>
                  <td>2 500</td>
                </tr>
              </tbody>
            </table>
          </div>

          <p class="step__sublabel" style="margin-top: var(--space-md)">Paso 2: promociones en "Productos CON Receta"</p>
          <div class="table-wrap">
            <table class="data-table data-table--sm">
              <thead>
                <tr>
                  <th>NOMBRE</th>
                  <th>CODIGO EXTERNO</th>
                  <th>UND.</th>
                  <th>Ingrediente 1</th>
                  <th>Cantidad 1</th>
                  <th>Ingrediente 2</th>
                  <th>Cantidad 2</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Promo Happy Hour (Pisco+Vino)</td>
                  <td><code>PROMO-HH-001</code></td>
                  <td>combo</td>
                  <td>Botella Pisco Alto del Carmen</td>
                  <td>0.5</td>
                  <td>Vino Latitud Sur Cabernet</td>
                  <td>0.5</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="divider" aria-hidden="true"></div>

          <h3>Ejemplo B — Restaurante</h3>

          <p class="step__sublabel">Paso 1: ingredientes en "Productos SIN Receta"</p>
          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>NOMBRE</th>
                  <th>CODIGO EXTERNO</th>
                  <th>UNIDAD DE MEDIDA</th>
                  <th>COSTO ESTIMADO</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Masa de pizza</td>
                  <td><code>ING-MASA-PIZ</code></td>
                  <td>kg</td>
                  <td>3 000</td>
                </tr>
                <tr>
                  <td>Queso mozzarella</td>
                  <td><code>ING-QUESO-MOZ</code></td>
                  <td>kg</td>
                  <td>12 000</td>
                </tr>
                <tr>
                  <td>Salsa de tomate</td>
                  <td><code>ING-SALSA-TOM</code></td>
                  <td>litro</td>
                  <td>2 500</td>
                </tr>
              </tbody>
            </table>
          </div>

          <p class="step__sublabel" style="margin-top: var(--space-md)">Paso 2: platillos en "Productos CON Receta"</p>
          <div class="table-wrap">
            <table class="data-table data-table--sm">
              <thead>
                <tr>
                  <th>NOMBRE</th>
                  <th>CODIGO EXTERNO</th>
                  <th>UND.</th>
                  <th>Ing. 1</th>
                  <th>Cant. 1</th>
                  <th>Ing. 2</th>
                  <th>Cant. 2</th>
                  <th>Ing. 3</th>
                  <th>Cant. 3</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Pizza Margarita Mediana</td>
                  <td><code>PLAT-PIZ-MARM</code></td>
                  <td>unidad</td>
                  <td>Masa de pizza</td>
                  <td>0.3</td>
                  <td>Queso mozzarella</td>
                  <td>0.15</td>
                  <td>Salsa de tomate</td>
                  <td>0.1</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- ── 6. Errores Comunes ── -->
        <section id="errores" class="step" aria-labelledby="errores-h">
          <div class="step__head">
            <span class="step__n">6</span>
            <h2 id="errores-h">Errores comunes</h2>
          </div>

          <div class="error-list">
            <div class="error-item">
              <div class="error-item__head">
                <span class="error-item__icon" aria-hidden="true">!</span>
                <h3>Código Externo repetido</h3>
              </div>
              <p><strong>Síntoma:</strong> Error de duplicado al intentar cargar los datos.</p>
              <p><strong>Solución:</strong> Revisa todas las filas y asegúrate que cada Código Externo sea único en ambas hojas. Usa un patrón consistente, ej.: <code>PREFIJO-CATEGORIA-ID</code>.</p>
            </div>

            <div class="error-item">
              <div class="error-item__head">
                <span class="error-item__icon" aria-hidden="true">!</span>
                <h3>Ingrediente que no existe</h3>
              </div>
              <p><strong>Síntoma:</strong> Error indicando que el ingrediente no es válido.</p>
              <p><strong>Solución:</strong> Verifica que el nombre del ingrediente sea exactamente igual — mayúsculas, espacios y tildes — al nombre registrado en cualquiera de las dos hojas de productos.</p>
            </div>

            <div class="error-item">
              <div class="error-item__head">
                <span class="error-item__icon" aria-hidden="true">!</span>
                <h3>Código Externo vacío</h3>
              </div>
              <p><strong>Síntoma:</strong> Validación que exige un valor.</p>
              <p><strong>Solución:</strong> Siempre rellena el Código Externo. Si no tienes uno, inventa un patrón propio, ej.: <code>PROD-0001</code>, <code>PROD-0002</code>.</p>
            </div>

            <div class="error-item">
              <div class="error-item__head">
                <span class="error-item__icon" aria-hidden="true">!</span>
                <h3>Cantidad en blanco o con texto</h3>
              </div>
              <p><strong>Síntoma:</strong> Errores de cálculo o validación en recetas.</p>
              <p><strong>Solución:</strong> Usa números con punto decimal (<code>0.3</code>, no <code>0,3</code>). Si un ingrediente no aplica, deja esa columna en blanco.</p>
            </div>

            <div class="error-item">
              <div class="error-item__head">
                <span class="error-item__icon" aria-hidden="true">!</span>
                <h3>Datos en filas de encabezado</h3>
              </div>
              <p><strong>Síntoma:</strong> Los datos no aparecen o se mezclan con los encabezados.</p>
              <p><strong>Solución:</strong> <strong>Siempre empieza en la fila 3</strong>. Las filas 1 y 2 son encabezados y están reservadas.</p>
            </div>
          </div>

          <div class="error-item">
            <div class="error-item__head">
              <span class="error-item__icon" aria-hidden="true">!</span>
              <h3>Hojas o columnas renombradas</h3>
            </div>
            <p><strong>Síntoma:</strong> La carga falla o los datos no se reconocen.</p>
            <p><strong>Solución:</strong> No cambies el nombre de las hojas ni el orden de las columnas. La carga a la base de datos depende de que estén exactamente como vienen en la plantilla.</p>
          </div>

          <div class="callout callout--tip" style="margin-top: var(--space-md)">
            <p class="callout__title">Checklist antes de enviar</p>
            <ul role="list" class="checklist">
              <li>Todos los nombres completos</li>
              <li>Todos los Códigos Externos completos y únicos (entre ambas hojas)</li>
              <li>En CON Receta, todos los ingredientes existen en alguna hoja</li>
              <li>Las cantidades son números con punto decimal (ej: 0.3, no 0,3)</li>
              <li>No hay datos en las filas 1 y 2 (son encabezados)</li>
              <li>Los nombres de ingredientes coinciden exactamente (tildes, espacios, mayúsculas)</li>
              <li>No se renombraron hojas ni se reordenaron columnas</li>
            </ul>
          </div>
        </section>

        <aside class="doc-cta">
          <p>¿Tienes preguntas sobre la carga de productos?</p>
          <a href={site.orderUrl} class="doc-cta__btn">Contactar a SmartOrder →</a>
        </aside>
      </article>
    </div>
  </div>
</Layout>

<style>
  /* ── Layout base ── */
  .doc { padding-block: var(--space-lg) var(--space-xl); }
  .doc-crumbs { display: flex; gap: 0.6rem; align-items: center; font-size: var(--text-sm); color: var(--text-secondary); margin-bottom: var(--space-md); flex-wrap: wrap; }
  .doc-crumbs a { color: var(--text-secondary); text-decoration: none; }
  .doc-crumbs a:hover { color: var(--accent); }

  .doc-layout { display: grid; grid-template-columns: 1fr; gap: var(--space-md); align-items: start; }

  /* ── Sidebar ── */
  .doc-side__toggle {
    display: flex; width: 100%; align-items: center; justify-content: space-between; gap: var(--space-xs);
    padding: 0.75rem var(--space-sm); min-height: 48px;
    background: var(--bg-secondary); border: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
    border-radius: var(--radius-md); color: var(--text-primary);
    font-family: var(--font-body); font-size: var(--text-sm); font-weight: 500; cursor: pointer;
    position: sticky; top: 0.75rem; z-index: var(--z-above);
  }
  .doc-side__toggle svg { transition: transform var(--transition-fast); }
  .doc-side[data-open] .doc-side__toggle svg { transform: rotate(180deg); }
  .doc-side__nav {
    display: none; margin-top: var(--space-sm); padding: var(--space-sm);
    background: color-mix(in srgb, var(--bg-secondary) 70%, transparent);
    border: 1px solid color-mix(in srgb, var(--border) 40%, transparent); border-radius: var(--radius-md);
  }
  .doc-side[data-open] .doc-side__nav { display: block; }
  .doc-side__list { list-style: none; display: grid; gap: 2px; }
  .doc-side__link {
    display: flex; align-items: baseline; gap: 0.5rem; padding: 0.5rem 0.6rem; min-height: 36px; border-radius: var(--radius-sm);
    color: var(--text-primary); text-decoration: none; font-size: var(--text-sm); line-height: 1.35;
    border-left: 2px solid transparent; transition: color var(--transition-fast), background-color var(--transition-fast);
  }
  .doc-side__num { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--accent); min-width: 1.4rem; }
  .doc-side__link:hover { color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, transparent); }
  .doc-side__link[aria-current="true"] { color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, transparent); border-left-color: var(--accent); }

  /* ── Contenido ── */
  .doc-content { min-width: 0; max-width: 760px; }
  .doc-head { margin-bottom: var(--space-md); }
  .doc-tag {
    display: inline-block; font-family: var(--font-mono); font-size: var(--text-xs);
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent);
    padding: 0.3rem 0.7rem; border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: var(--radius-full); margin-bottom: var(--space-sm);
  }
  .doc-head h1 { font-family: var(--font-heading); font-weight: 600; font-size: clamp(2rem, 5vw, 3rem); line-height: 1.08; letter-spacing: -0.02em; }
  .doc-lead { font-size: var(--text-lg); line-height: 1.6; color: var(--text-secondary); margin-top: var(--space-sm); }

  .doc-content p { font-size: var(--text-base); line-height: 1.65; color: var(--text-primary); }
  .doc-content p + p { margin-top: var(--space-sm); }
  .doc-content strong { font-weight: 500; }
  .doc-content h3 { font-family: var(--font-heading); font-weight: 500; font-size: var(--text-lg); letter-spacing: -0.01em; margin: var(--space-md) 0 var(--space-xs); }

  /* ── Tarjeta de descarga ── */
  .step--download { border-top: none !important; padding-top: 0 !important; }
  .download-card {
    display: flex; align-items: center; gap: var(--space-md); flex-wrap: wrap;
    padding: var(--space-md);
    background: linear-gradient(120deg, color-mix(in srgb, var(--accent) 10%, var(--bg-secondary)), var(--bg-secondary));
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: var(--radius-lg);
  }
  .download-card__icon {
    display: grid; place-items: center; flex-shrink: 0;
    width: 56px; height: 56px; border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--accent) 12%, var(--bg-secondary));
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--accent);
  }
  .download-card__info { flex: 1; min-width: 0; }
  .download-card__name { font-family: var(--font-mono); font-size: var(--text-sm); font-weight: 500; color: var(--text-primary) !important; margin: 0 !important; }
  .download-card__meta { font-size: var(--text-xs) !important; color: var(--text-secondary) !important; margin-top: 0.2rem !important; }
  .download-card__btn {
    display: inline-flex; align-items: center; gap: 0.5rem; flex-shrink: 0;
    padding: 0.75rem 1.4rem; background: var(--accent); color: var(--bg-primary);
    font-family: var(--font-body); font-size: var(--text-sm); font-weight: 500;
    text-decoration: none; border-radius: var(--radius-full);
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }
  .download-card__btn:hover { background: var(--accent-hover); transform: translateY(-1px); }

  /* ── Pasos ── */
  .step { scroll-margin-top: 5.5rem; margin-top: var(--space-lg); padding-top: var(--space-md); border-top: 1px solid color-mix(in srgb, var(--border) 30%, transparent); }
  .step__head { display: flex; align-items: center; gap: var(--space-sm); margin-bottom: var(--space-sm); }
  .step__n {
    display: grid; place-items: center; flex-shrink: 0;
    width: 2.2rem; height: 2.2rem; border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    font-family: var(--font-mono); color: var(--accent); font-size: var(--text-base);
  }
  .step h2 { font-family: var(--font-heading); font-weight: 500; font-size: var(--text-xl); letter-spacing: -0.01em; }
  .step__sublabel { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); margin-bottom: var(--space-xs) !important; }

  /* ── Lista de pasos numerados ── */
  .steps-list { list-style: none; display: grid; gap: var(--space-sm); margin-top: var(--space-sm); }
  .steps-list--compact { gap: var(--space-xs); }
  .steps-list__item { display: flex; align-items: flex-start; gap: var(--space-sm); }
  .steps-list__n {
    display: grid; place-items: center; flex-shrink: 0;
    width: 1.8rem; height: 1.8rem; border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--bg-secondary) 90%, transparent);
    border: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
    font-family: var(--font-mono); color: var(--text-secondary); font-size: var(--text-xs);
    margin-top: 0.1rem;
  }
  .steps-list__item h3 { font-family: var(--font-heading); font-weight: 500; font-size: var(--text-base); letter-spacing: -0.01em; margin: 0 0 0.35rem; }
  .steps-list__item p { margin: 0 !important; font-size: var(--text-sm) !important; color: var(--text-secondary) !important; }

  /* ── Diagrama de hojas ── */
  .diagram { margin: var(--space-sm) 0; display: grid; gap: 2px; }
  .diagram__row {
    display: flex; align-items: center; gap: var(--space-sm);
    padding: 0.65rem var(--space-sm); border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--bg-secondary) 50%, transparent);
    border: 1px solid color-mix(in srgb, var(--border) 30%, transparent);
    opacity: 0.55;
  }
  .diagram__row--active {
    opacity: 1;
    background: color-mix(in srgb, var(--accent) 6%, var(--bg-secondary));
    border-color: color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .diagram__n { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--accent); min-width: 1.8rem; flex-shrink: 0; }
  .diagram__body { display: flex; align-items: center; gap: 0.5rem; flex: 1; min-width: 0; flex-wrap: wrap; }
  .diagram__label { font-size: var(--text-sm); font-weight: 500; color: var(--text-primary); }
  .diagram__desc { font-size: var(--text-xs); color: var(--text-secondary); margin-left: auto; text-align: right; flex-shrink: 0; }
  .diagram__action {
    font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.06em; text-transform: uppercase;
    padding: 0.15rem 0.5rem; border-radius: var(--radius-full); border: 1px solid; white-space: nowrap;
  }
  .diagram__action--fill { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 40%, transparent); background: color-mix(in srgb, var(--accent) 10%, transparent); }
  .diagram__action--optional { color: var(--text-secondary); border-color: color-mix(in srgb, var(--border) 60%, transparent); background: color-mix(in srgb, var(--bg-secondary) 50%, transparent); }
  .diagram__action--readonly { color: #f59e0b; border-color: color-mix(in srgb, #f59e0b 35%, transparent); background: color-mix(in srgb, #f59e0b 8%, transparent); }

  /* ── Campos ── */
  .field-group {
    margin: var(--space-sm) 0;
    padding: var(--space-sm) var(--space-md);
    background: color-mix(in srgb, var(--bg-secondary) 60%, transparent);
    border: 1px solid color-mix(in srgb, var(--border) 40%, transparent);
    border-left: 2px solid color-mix(in srgb, var(--accent) 55%, transparent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }
  .field-group__title { font-size: var(--text-sm) !important; font-weight: 500 !important; margin-bottom: var(--space-xs) !important; color: var(--text-primary) !important; }
  .field-list { list-style: none; display: grid; gap: 0.4rem; margin: 0; }
  .field-list li { font-size: var(--text-sm) !important; color: var(--text-secondary) !important; padding-left: var(--space-sm); position: relative; }
  .field-list li::before { content: "→"; position: absolute; left: 0; color: var(--accent); font-size: var(--text-xs); top: 0.15rem; }

  /* ── Badges ── */
  .badge {
    display: inline-block; font-family: var(--font-mono); font-size: 0.65rem;
    letter-spacing: 0.06em; text-transform: uppercase; padding: 0.2rem 0.5rem;
    border-radius: var(--radius-full); vertical-align: middle; margin-left: 0.4rem;
  }
  .badge--required { background: color-mix(in srgb, var(--accent) 15%, transparent); color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent); }
  .badge--optional { background: color-mix(in srgb, var(--text-secondary) 12%, transparent); color: var(--text-secondary); border: 1px solid color-mix(in srgb, var(--border) 50%, transparent); }

  /* ── Callouts ── */
  .callout {
    margin: var(--space-sm) 0; padding: var(--space-sm) var(--space-md);
    border-radius: 0 var(--radius-md) var(--radius-md) 0; border-left: 2px solid;
  }
  .callout p, .callout li { font-size: var(--text-sm) !important; line-height: 1.6 !important; }
  .callout strong { font-weight: 500; }
  .callout__title { font-weight: 500 !important; margin-bottom: 0.4rem !important; color: var(--text-primary) !important; }

  .callout--tip {
    background: color-mix(in srgb, var(--accent) 7%, var(--bg-secondary));
    border-color: var(--accent);
  }
  .callout--warning {
    background: color-mix(in srgb, #f59e0b 7%, var(--bg-secondary));
    border-color: #f59e0b;
  }
  .callout--warning strong { color: #f59e0b; }
  .callout--example {
    background: color-mix(in srgb, var(--bg-secondary) 80%, transparent);
    border: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
    border-left: 2px solid color-mix(in srgb, var(--accent) 50%, transparent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  /* ── Tablas ── */
  .table-wrap {
    position: relative;
    overflow-x: auto; -webkit-overflow-scrolling: touch;
    margin: var(--space-sm) 0;
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in srgb, var(--border) 40%, transparent);
    scroll-behavior: smooth;
  }
  /* fade derecho — solo visible cuando hay overflow pendiente */
  .table-wrap::after {
    content: '';
    position: sticky; right: 0; top: 0;
    display: block; float: right;
    width: 56px; height: 100%;
    margin-left: -56px;
    background: linear-gradient(to right, transparent, var(--bg-primary) 85%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }
  .table-wrap.has-more::after { opacity: 1; }
  /* chip "desliza →" — fuera de la caja, alineado a la derecha */
  .scroll-hint {
    display: block; text-align: right;
    font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin-top: 0.3rem;
    transition: opacity 0.2s;
    pointer-events: none;
  }
  .scroll-hint.is-hidden { opacity: 0; }
  .data-table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); white-space: nowrap; }
  .data-table th {
    padding: 0.6rem 0.9rem; text-align: left; font-family: var(--font-mono); font-size: 0.7rem;
    font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-secondary);
    background: color-mix(in srgb, var(--bg-secondary) 80%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
  }
  .data-table td {
    padding: 0.65rem 0.9rem; color: var(--text-primary); line-height: 1.45;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 25%, transparent);
  }
  .data-table tr:last-child td { border-bottom: none; }
  .data-table tr:nth-child(even) td { background: color-mix(in srgb, var(--bg-secondary) 30%, transparent); }
  .data-table--sm { font-size: 0.78rem; }
  .data-table--sm th { font-size: 0.65rem; padding: 0.5rem 0.75rem; }
  .data-table--sm td { padding: 0.55rem 0.75rem; }

  code {
    font-family: var(--font-mono); font-size: 0.85em; padding: 0.15em 0.4em;
    background: color-mix(in srgb, var(--accent) 10%, var(--bg-secondary));
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    border-radius: var(--radius-sm); color: var(--accent);
  }
  code.req { background: color-mix(in srgb, var(--accent) 14%, var(--bg-secondary)); }

  /* ── Bullets ── */
  .doc-bullets { list-style: none; display: grid; gap: 0.5rem; margin-top: var(--space-sm); }
  .doc-bullets > li { position: relative; padding-left: 1.3rem; font-size: var(--text-base); line-height: 1.65; color: var(--text-primary); }
  .doc-bullets > li::before { content: ""; position: absolute; left: 0.1rem; top: 0.65em; width: 5px; height: 5px; border-radius: var(--radius-full); background: var(--accent); }

  /* ── Errores ── */
  .error-list { display: grid; gap: var(--space-sm); margin-top: var(--space-sm); }
  .error-item {
    padding: var(--space-sm) var(--space-md);
    background: color-mix(in srgb, #ef4444 5%, var(--bg-secondary));
    border: 1px solid color-mix(in srgb, #ef4444 20%, transparent);
    border-left: 2px solid #ef4444; border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }
  .error-item__head { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem; }
  .error-item__icon {
    display: grid; place-items: center; width: 1.4rem; height: 1.4rem; flex-shrink: 0;
    border-radius: var(--radius-full); background: #ef4444; color: #fff;
    font-family: var(--font-mono); font-size: 0.7rem; font-weight: 500;
  }
  .error-item h3 { font-family: var(--font-heading); font-weight: 500; font-size: var(--text-base); margin: 0; }
  .error-item p { font-size: var(--text-sm) !important; }
  .error-item p + p { margin-top: 0.35rem !important; }

  /* ── Checklist ── */
  .checklist { list-style: none; display: grid; gap: 0.45rem; margin: var(--space-xs) 0 0; padding: 0; }
  .checklist li { display: flex; align-items: flex-start; gap: 0.5rem; font-size: var(--text-sm) !important; color: var(--text-secondary) !important; }
  .checklist li::before { content: "☐"; flex-shrink: 0; color: var(--accent); font-size: var(--text-base); line-height: 1.2; }

  /* ── Divider ── */
  .divider { height: 1px; background: color-mix(in srgb, var(--border) 35%, transparent); margin: var(--space-md) 0; }

  /* ── CTA ── */
  .doc-cta {
    margin-top: var(--space-lg); padding: var(--space-md); text-align: center;
    background: color-mix(in srgb, var(--accent) 6%, var(--bg-secondary));
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent); border-radius: var(--radius-lg);
  }
  .doc-cta p { font-size: var(--text-lg); color: var(--text-primary); margin-bottom: var(--space-sm); }
  .doc-cta__btn {
    display: inline-block; padding: 0.8rem 1.6rem; background: var(--accent); color: var(--bg-primary);
    font-weight: 600; text-decoration: none; border-radius: var(--radius-full); transition: background-color var(--transition-fast);
  }
  .doc-cta__btn:hover { background: var(--accent-hover); }

  /* ── Accesibilidad ── */
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

  /* ── Desktop ── */
  @media (min-width: 1024px) {
    .doc-layout { grid-template-columns: 240px 1fr; gap: var(--space-lg); }
    .doc-side { position: sticky; top: var(--space-lg); max-height: calc(100vh - var(--space-lg) * 2); overflow-y: auto; }
    .doc-side__toggle { display: none; }
    .doc-side__nav { display: block; margin-top: 0; background: transparent; border: none; padding: 0; }
    .diagram__desc { display: block; }
  }

  @media (max-width: 1023px) {
    .diagram__desc { display: none; }
    .download-card { gap: var(--space-sm); }
  }
</style>

<script>
  function initRecursos() {
    const aside = document.querySelector('.doc-side');
    const nav = document.getElementById('doc-index');
    const content = document.querySelector('.doc-content');
    if (!aside || !nav || !content) return;

    // Sidebar toggle (mobile)
    const toggle = aside.querySelector('.doc-side__toggle');
    toggle?.addEventListener('click', () => {
      const open = aside.hasAttribute('data-open');
      open ? aside.removeAttribute('data-open') : aside.setAttribute('data-open', '');
      toggle.setAttribute('aria-expanded', String(!open));
    });
    nav.addEventListener('click', (ev) => {
      if ((ev.target as HTMLElement).closest('a') && window.matchMedia('(max-width: 1023px)').matches) {
        aside.removeAttribute('data-open');
        toggle?.setAttribute('aria-expanded', 'false');
      }
    });

    // Scrollspy
    const links = new Map<string, HTMLAnchorElement>();
    nav.querySelectorAll('a[href^="#"]').forEach((a) => links.set(a.getAttribute('href')!.slice(1), a as HTMLAnchorElement));
    const sections = Array.from(content.querySelectorAll('.step'));
    let current = '';
    const spy = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          const id = (e.target as HTMLElement).id;
          if (id === current) continue;
          links.get(current)?.removeAttribute('aria-current');
          links.get(id)?.setAttribute('aria-current', 'true');
          current = id;
        }
      }
    }, { rootMargin: '-20% 0px -70% 0px' });
    sections.forEach((s) => spy.observe(s));

    // Scroll hint en tablas con overflow horizontal
    function updateScrollHint(wrap: HTMLElement) {
      const hasMore = wrap.scrollLeft + wrap.clientWidth < wrap.scrollWidth - 4;
      wrap.classList.toggle('has-more', hasMore);
      const h = wrap.nextElementSibling;
      if (h?.classList.contains('scroll-hint')) h.classList.toggle('is-hidden', !hasMore);
    }

    document.querySelectorAll<HTMLElement>('.table-wrap').forEach((wrap) => {
      let hint: HTMLElement | null = null;

      const checkAndInject = () => {
        const overflows = wrap.scrollWidth > wrap.clientWidth + 4;
        if (overflows && !hint) {
          hint = document.createElement('span');
          hint.className = 'scroll-hint';
          hint.setAttribute('aria-hidden', 'true');
          hint.innerHTML = 'desliza &rarr;';
          wrap.insertAdjacentElement('afterend', hint);
          wrap.addEventListener('scroll', () => updateScrollHint(wrap), { passive: true });
        }
        if (hint) hint.classList.toggle('is-hidden', !overflows);
        updateScrollHint(wrap);
      };

      requestAnimationFrame(checkAndInject);
      window.addEventListener('resize', checkAndInject, { passive: true });
    });
  }

  document.addEventListener('astro:page-load', initRecursos);
</script>
